<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Results - Quizzard</title>
  <script>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches)) {
      document.documentElement.classList.add('theme-light');
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0c0a09">
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then((reg) => console.log('Service Worker registered in result:', reg.scope))
          .catch((err) => console.error('Service Worker registration in result failed:', err));
      });
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <style>
    /* Light/Cream Theme overrides */
    .theme-light body {
      background: linear-gradient(135deg, #fdfbf7 0%, #f4efe6 50%, #e9e0d2 100%);
      color: #292524;
    }
    .theme-light .glass-card {
      background: rgba(253, 251, 247, 0.75);
      border-color: rgba(41, 37, 36, 0.08);
      box-shadow: 0 10px 30px -10px rgba(120, 110, 90, 0.2), 0 1px 3px rgba(120, 110, 90, 0.05);
    }
    .theme-light h1, .theme-light h2, .theme-light h3 {
      color: #1c1917;
    }
    .theme-light p, .theme-light label {
      color: #44403c;
    }
    .theme-light .text-stone-300 {
      color: #292524;
    }
    .theme-light .text-stone-400, .theme-light .text-stone-550, .theme-light .text-stone-500 {
      color: #57524d;
    }
    .theme-light .text-stone-100 {
      color: #1c1917;
    }
    .theme-light .neon-border {
      background-color: rgba(255, 255, 255, 0.6);
      border-color: rgba(41, 37, 36, 0.12);
    }
    .theme-light select, .theme-light input[type="text"], .theme-light textarea {
      color: #1c1917;
    }
    .theme-light select option {
      background-color: #fdfbf7;
      color: #1c1917;
    }
    .theme-light #theme-toggle {
      background-color: rgba(253, 251, 247, 0.8);
      border-color: rgba(41, 37, 36, 0.1);
      color: #1c1917;
      box-shadow: 0 4px 12px rgba(120, 110, 90, 0.1);
    }
    .theme-light #theme-toggle:hover {
      background-color: rgba(253, 251, 247, 0.95);
    }
    .theme-light .score-circle {
      background: radial-gradient(circle, rgba(245, 158, 11, 0.05) 0%, rgba(217, 119, 6, 0.08) 100%);
      border-color: rgba(217, 119, 6, 0.2);
    }
    .theme-light .bg-stone-900\/40, .theme-light .bg-stone-900\/80 {
      background-color: rgba(255, 255, 255, 0.5);
      border-color: rgba(41, 37, 36, 0.1);
    }
    .theme-light .border-stone-850 {
      border-color: rgba(41, 37, 36, 0.1);
    }
    .theme-light .bg-amber-950\/20 {
      background-color: rgba(245, 158, 11, 0.06);
      border-color: rgba(245, 158, 11, 0.4);
      color: #b45309;
    }
    .theme-light .text-emerald-400 {
      color: #047857;
    }
    .theme-light .text-red-400 {
      color: #b91c1c;
    }
    .theme-light .bg-stone-850 {
      background-color: rgba(41, 37, 36, 0.08);
      color: #57524d;
    }

    body {
      font-family: 'Outfit', sans-serif;
    }

    .glass-card {
      background: rgba(28, 25, 23, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .score-circle {
      background: radial-gradient(circle, rgba(245, 158, 11, 0.1) 0%, rgba(217, 119, 6, 0.15) 100%);
    }
  </style>
</head>

<body
  class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  <!-- Decorative background glow blobs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-2xl w-full">
    <!-- Main Card -->
    <div class="glass-card rounded-2xl shadow-2xl p-6 sm:p-8 text-center space-y-6 relative overflow-hidden">

      <!-- Congratulations Wizard Header -->
      <div class="text-6xl animate-bounce">🏆</div>
      <h1
        class="text-3xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-amber-200 to-yellow-400">
        Quiz Completed!
      </h1>

      <!-- Streak Badge -->
      <div id="streak-badge-container" class="mt-2 flex justify-center items-center hidden">
        <span class="inline-flex items-center gap-1.5 bg-orange-500/10 border border-orange-500/30 text-orange-400 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
          🔥 <span id="streak-count">0</span> Day Study Streak
        </span>
      </div>

      <!-- Score Circle Indicator -->
      <div
        class="score-circle w-32 h-32 rounded-full border-2 border-amber-550/30 flex flex-col items-center justify-center mx-auto shadow-lg shadow-amber-500/10">
        <p class="text-4xl font-extrabold text-white leading-tight">
          <%= score %>
        </p>
        <p class="text-xs text-stone-400 font-semibold tracking-wider border-t border-stone-850 pt-1 mt-1 px-4">OUT OF
          <%= total %>
        </p>
      </div>

      <div class="space-y-2">
        <p class="text-xl font-medium text-stone-200">
          <%= message %>
        </p>
        <p id="percentage-label" class="text-sm text-amber-400 font-semibold"></p>
      </div>

      <!-- Timed Challenge Results Details -->
      <div id="challenge-details" class="hidden mt-4 p-4 bg-amber-500/5 border border-amber-500/20 rounded-xl max-w-sm mx-auto space-y-2">
        <p class="text-xs text-stone-400 font-medium">⚡ TIMED CHALLENGE METRICS</p>
        <div class="flex justify-between items-center text-sm">
          <span class="text-stone-300">Completion Time:</span>
          <span id="challenge-time-val" class="font-mono text-amber-400 font-bold text-base">00:00.000</span>
        </div>
        <button id="btn-leaderboard-redirect" class="w-full mt-2 bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold py-2 px-4 rounded-lg shadow text-xs transition">
          🏆 View Global Leaderboard
        </button>
      </div>

      <% if (typeof opponentName !== 'undefined' && opponentName) { %>
        <!-- Multiplayer Results comparison -->
        <div class="mt-4 p-4 bg-stone-900/60 border border-stone-850 rounded-xl max-w-sm mx-auto flex justify-between items-center text-sm">
          <div class="text-left">
            <p class="text-stone-400 text-xs uppercase font-semibold">You</p>
            <p class="text-lg font-bold text-amber-400"><%= score %> / <%= total %></p>
          </div>
          <div class="text-stone-600 font-bold text-base">VS</div>
          <div class="text-right">
            <p class="text-stone-400 text-xs uppercase font-semibold"><%= opponentName %></p>
            <p class="text-lg font-bold text-amber-400"><%= opponentScore %> / <%= total %></p>
          </div>
        </div>
      <% } %>

      <!-- Category Breakdown Section -->
      <div id="category-breakdown-section" class="hidden text-left bg-stone-900/40 border border-stone-850 rounded-xl p-4 sm:p-5 space-y-3">
        <h3 class="text-xs font-bold text-stone-400 tracking-wider uppercase">Performance by Subtopic</h3>
        <div id="category-breakdown-container" class="space-y-3"></div>
      </div>

      <!-- Action Buttons -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
        <button id="btn-review"
          class="bg-stone-900/80 border border-stone-800 text-stone-300 hover:text-white font-semibold p-3.5 rounded-lg transition duration-300 hover:border-amber-500/50 active:scale-[0.99] flex items-center justify-center gap-2">
          🔍 Review Explanations
        </button>
        <button id="btn-bookmarks"
          class="bg-stone-900/80 border border-stone-800 text-stone-300 hover:text-white font-semibold p-3.5 rounded-lg transition duration-300 hover:border-amber-500/50 active:scale-[0.99] flex items-center justify-center gap-2">
          ⭐ Bookmarked Questions
        </button>
        <button id="btn-share"
          class="bg-stone-900/80 border border-stone-800 text-stone-300 hover:text-white font-semibold p-3.5 rounded-lg transition duration-300 hover:border-amber-500/50 active:scale-[0.99] flex items-center justify-center gap-2">
          🔗 Share Score
        </button>
        <a href="/"
          class="bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold p-3.5 rounded-lg shadow-lg active:scale-[0.99] transition duration-300 flex items-center justify-center gap-2">
          Take Another Quiz ➡️
        </a>
      </div>

      <!-- Reset Cache Area -->
      <div class="pt-4 border-t border-stone-850/50 mt-4 text-center">
        <button id="btn-reset-cache" type="button"
          class="text-xs text-red-400 hover:text-red-300 hover:underline transition">
          🗑️ Reset Quiz Progress & Cache
        </button>
      </div>

      <!-- Review Section (Hidden initially) -->
      <div id="review-section"
        class="hidden text-left pt-6 border-t border-stone-850 space-y-6 max-h-[400px] overflow-y-auto pr-2">
        <h3 class="text-lg font-bold text-stone-200 mb-4 flex items-center gap-2">
          <span>🧠</span> Concept Review
        </h3>
        <div id="review-container" class="space-y-4">
          <div class="animate-pulse flex space-x-4">
            <div class="flex-1 space-y-4 py-1">
              <div class="h-4 bg-stone-900 rounded w-3/4"></div>
              <div class="space-y-2">
                <div class="h-4 bg-stone-900 rounded"></div>
                <div class="h-4 bg-stone-900 rounded w-5/6"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Bookmarks Section (Hidden initially) -->
      <div id="bookmarks-section"
        class="hidden text-left pt-6 border-t border-stone-850 space-y-6 max-h-[400px] overflow-y-auto pr-2">
        <h3 class="text-lg font-bold text-stone-200 mb-4 flex items-center gap-2">
          <span>⭐</span> Bookmarked Questions
        </h3>
        <div id="bookmarks-container" class="space-y-4">
          <p class="text-xs text-stone-500">You haven't bookmarked any questions yet.</p>
        </div>
      </div>

    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Streak Calculation
      function getLocalDateString() {
        const d = new Date();
        const year = d.getFullYear();
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');
        return `${year}-${month}-${day}`;
      }

      function getDaysDifference(dateStr1, dateStr2) {
        if (!dateStr1 || !dateStr2) return Infinity;
        const d1 = new Date(dateStr1);
        const d2 = new Date(dateStr2);
        d1.setHours(0,0,0,0);
        d2.setHours(0,0,0,0);
        const diffTime = Math.abs(d2 - d1);
        return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      }

      const currentDate = getLocalDateString();
      const rawData = localStorage.getItem('streakData');
      let streakData = { streak: 0, lastDate: null };

      try {
        if (rawData) {
          streakData = JSON.parse(rawData);
        }
      } catch (e) {
        console.error("Error parsing streakData", e);
      }

      if (!streakData.lastDate) {
        streakData.streak = 1;
        streakData.lastDate = currentDate;
      } else {
        const diff = getDaysDifference(streakData.lastDate, currentDate);
        if (diff === 1) {
          streakData.streak += 1;
          streakData.lastDate = currentDate;
        } else if (diff > 1) {
          streakData.streak = 1;
          streakData.lastDate = currentDate;
        }
      }

      localStorage.setItem('streakData', JSON.stringify(streakData));

      if (streakData.streak > 0) {
        document.getElementById('streak-count').textContent = streakData.streak;
        document.getElementById('streak-badge-container').classList.remove('hidden');
      }

      // Calculate percentage
      const score = parseInt("<%= score %>", 10);
      const total = parseInt("<%= total %>", 10);
      const percent = total > 0 ? Math.round((score / total) * 100) : 0;
      document.getElementById('percentage-label').textContent = `${percent}% Accuracy Rate`;
      // Celebrate perfect score
      if (score === total && total > 0) {
        setTimeout(() => {
          confetti({
            particleCount: 150,
            spread: 90,
            origin: { y: 0.6 }
          });

          setTimeout(() => {
            confetti({
              particleCount: 100,
              angle: 60,
              spread: 70,
              origin: { x: 0 }
            });

            confetti({
              particleCount: 100,
              angle: 120,
              spread: 70,
              origin: { x: 1 }
            });
          }, 300);
        }, 400);
      }

      // Share score logic
      const urlParams = new URLSearchParams(window.location.search);
      const sectionId = urlParams.get('sectionId');
      
      // Timed challenge mode handling
      const isChallenge = urlParams.get('challenge') === 'true';
      const timeMs = parseInt(urlParams.get('timeMs'), 10);
      
      if (isChallenge && !isNaN(timeMs)) {
        document.getElementById('challenge-details').classList.remove('hidden');
        
        const totalSec = timeMs / 1000;
        const min = Math.floor(totalSec / 60);
        const sec = Math.floor(totalSec % 60);
        const msec = Math.floor(timeMs % 1000);
        const pad = (num, size) => ('00' + num).slice(-size);
        const formattedTime = `${pad(min, 2)}:${pad(sec, 2)}.${pad(msec, 3)}`;
        
        document.getElementById('challenge-time-val').textContent = formattedTime;
        
        document.getElementById('btn-leaderboard-redirect').addEventListener('click', () => {
          if (sectionId) {
            window.location.href = `/leaderboard/${sectionId}`;
          }
        });
      }
      
      let sectionName = '';

      function saveQuizToHistory(topic, score, total) {
        // Prevent double saving if user refreshes the result page
        const sessionSavedKey = `history_saved_${window.location.search}`;
        if (sessionStorage.getItem(sessionSavedKey)) return;
        sessionStorage.setItem(sessionSavedKey, 'true');

        let history = JSON.parse(localStorage.getItem('quizHistory') || '[]');
        const attempt = {
          topic: topic || 'Custom AI Quiz',
          score: score,
          total: total,
          date: new Date().toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })
        };
        // Add to front of list
        history.unshift(attempt);
        // Keep last 15
        history = history.slice(0, 15);
        localStorage.setItem('quizHistory', JSON.stringify(history));
      }

      if (sectionId) {
        fetch(`/api/quiz/sections/${sectionId}`)
          .then(res => res.json())
          .then(section => {
            sectionName = section.name;
            saveQuizToHistory(sectionName, score, total);
          })
          .catch(err => {
            console.error("Error loading section name for sharing:", err);
            saveQuizToHistory('Custom AI Quiz', score, total);
          });
      } else {
        saveQuizToHistory('Custom AI Quiz', score, total);
      }

      const btnShare = document.getElementById('btn-share');
      if (btnShare) {
        btnShare.addEventListener('click', async () => {
          const topicText = sectionName ? ` the ${sectionName}` : '';
          const shareText = `I scored ${score}/${total} on${topicText} quiz on Quizzard! Can you beat me?`;

          try {
            await navigator.clipboard.writeText(shareText);
            const originalText = btnShare.innerHTML;
            btnShare.innerHTML = '✅ Copied!';
            setTimeout(() => {
              btnShare.innerHTML = originalText;
            }, 2000);
          } catch (err) {
            console.error('Failed to copy text: ', err);
            alert('Failed to copy score. Here it is: ' + shareText);
          }
        });
      }

      // Reset Cache click listener
      const btnResetCache = document.getElementById('btn-reset-cache');
      if (btnResetCache) {
        btnResetCache.addEventListener('click', () => {
          if (confirm('Are you sure you want to clear the cached answers for this quiz attempt?')) {
            window.localStorage.removeItem('userAnswers');
            window.localStorage.removeItem('activeReviewQuestionIds');
            window.localStorage.removeItem('challengeMode');
            window.location.href = '/';
          }
        });
      }

      // Review explanations & category breakdown logic
      const btnReview = document.getElementById('btn-review');
      const reviewSection = document.getElementById('review-section');
      const reviewContainer = document.getElementById('review-container');

      let reviewsLoaded = false;

      async function initCategoryBreakdownAndReview() {
        const urlParams = new URLSearchParams(window.location.search);
        const sectionId = urlParams.get('sectionId');
        const isReview = urlParams.get('review') === 'true';
        const difficulty = window.localStorage.getItem('difficulty') || 'medium';

        if (!sectionId && !isReview) {
          reviewContainer.innerHTML = `<p class="text-xs text-stone-500">Explanations are only available for this active quiz session.</p>`;
          return;
        }

        try {
          let questions = [];
          if (isReview) {
            const reviewIds = JSON.parse(window.localStorage.getItem('activeReviewQuestionIds') || '[]');
            const res = await fetch('/api/quiz/questions-by-ids', {
              method: 'POST',
              body: JSON.stringify({ ids: reviewIds }),
              headers: { 'Content-Type': 'application/json' }
            });
            questions = await res.json();
          } else {
            const response = await fetch(`/api/quiz/questions/${sectionId}/${difficulty}`);
            questions = await response.json();
          }

          const userAnswers = JSON.parse(window.localStorage.getItem('userAnswers') || '{}');

          // Update Spaced Repetition scheduling
          const sm2SavedKey = `sm2_updated_${window.location.search}`;
          if (!sessionStorage.getItem(sm2SavedKey)) {
            sessionStorage.setItem(sm2SavedKey, 'true');
            let sm2Data = JSON.parse(localStorage.getItem('sm2Data') || '{}');
            questions.forEach(q => {
              const selectedOption = parseInt(userAnswers[`question-${q.id}`], 10);
              const isCorrect = (selectedOption === q.correct_option);
              
              let qData = sm2Data[q.id] || { interval: 1, repetitions: 0, easeFactor: 2.5 };
              
              if (isCorrect) {
                if (qData.repetitions === 0) {
                  qData.interval = 1;
                } else if (qData.repetitions === 1) {
                  qData.interval = 6;
                } else {
                  qData.interval = Math.round(qData.interval * qData.easeFactor);
                }
                qData.repetitions += 1;
                qData.easeFactor = Math.max(1.3, qData.easeFactor + (0.1 - (5 - 4) * (0.08 + (5 - 4) * 0.02)));
              } else {
                qData.interval = 1;
                qData.repetitions = 0;
                qData.easeFactor = Math.max(1.3, qData.easeFactor - 0.2);
              }
              
              const today = new Date();
              today.setHours(0,0,0,0);
              const nextReview = new Date(today);
              nextReview.setDate(today.getDate() + qData.interval);
              
              qData.dueDate = nextReview.getTime();
              sm2Data[q.id] = qData;
            });
            localStorage.setItem('sm2Data', JSON.stringify(sm2Data));
          }

          // 1. Generate category breakdown
          const categories = {};
          questions.forEach(q => {
            const cat = q.category || 'General Concepts';
            if (!categories[cat]) {
              categories[cat] = { correct: 0, total: 0 };
            }
            categories[cat].total += 1;

            const selectedOption = parseInt(userAnswers[`question-${q.id}`], 10);
            if (selectedOption === q.correct_option) {
              categories[cat].correct += 1;
            }
          });

          // Render breakdown
          const container = document.getElementById('category-breakdown-container');
          const sectionEl = document.getElementById('category-breakdown-section');
          
          if (container && sectionEl) {
            container.innerHTML = '';
            const catNames = Object.keys(categories);
            if (catNames.length > 0) {
              sectionEl.classList.remove('hidden');
              catNames.forEach(catName => {
                const data = categories[catName];
                const percentage = Math.round((data.correct / data.total) * 100);
                
                const catCard = document.createElement('div');
                catCard.className = "space-y-1";
                catCard.innerHTML = `
                  <div class="flex justify-between text-[11px] font-medium text-stone-300">
                    <span>${catName}</span>
                    <span>${data.correct}/${data.total} (${percentage}%)</span>
                  </div>
                  <div class="h-1.5 w-full bg-stone-950 rounded-full overflow-hidden border border-stone-850">
                    <div class="h-full bg-gradient-to-r from-amber-500 to-yellow-500" style="width: ${percentage}%;"></div>
                  </div>
                `;
                container.appendChild(catCard);
              });
            }
          }

          // 2. Prepare review container
          reviewContainer.innerHTML = '';
          questions.forEach((q, idx) => {
            const selectedOption = parseInt(userAnswers[`question-${q.id}`], 10);
            const explanationHtml = q.explanation
              ? `<div class="mt-3 p-3 bg-amber-950/20 border-l-2 border-amber-500/50 rounded text-xs text-amber-200">
                   <strong>Explanation:</strong> ${q.explanation}
                 </div>`
              : '';

            const optionStates = [1, 2, 3, 4].map(optNum => {
              const text = q[`option${optNum}`];
              const isCorrect = q.correct_option === optNum;
              const isSelected = selectedOption === optNum;

              let styleClass = "text-stone-400";
              let indicator = "•";

              if (isCorrect) {
                styleClass = "text-emerald-400 font-medium";
                indicator = "✅";
              } else if (isSelected) {
                styleClass = "text-red-400 font-medium";
                indicator = "❌";
              }

              const selectionSuffix = isSelected ? ' <span class="text-[10px] bg-stone-850 text-stone-550 px-1 py-0.5 rounded ml-1 font-normal">(Your choice)</span>' : '';

              return `<p class="${styleClass}">${indicator} ${text}${selectionSuffix}</p>`;
            }).join('');

            const qCard = document.createElement('div');
            qCard.className = "p-4 rounded-lg bg-stone-900/40 border border-stone-850 space-y-2";
            qCard.innerHTML = `
              <div class="flex justify-between items-start gap-2">
                <p class="text-sm font-semibold text-stone-200">${idx + 1}. ${q.question}</p>
                ${q.category ? `<span class="text-[10px] bg-amber-500/10 text-amber-300 px-2 py-0.5 rounded-full border border-amber-500/20 font-bold uppercase tracking-wider font-mono">${q.category}</span>` : ''}
              </div>
              <div class="text-xs pl-4 space-y-1">
                ${optionStates}
              </div>
              ${explanationHtml}
            `;
            reviewContainer.appendChild(qCard);
          });
          reviewsLoaded = true;

        } catch (err) {
          console.error("Error loading explanations:", err);
          reviewContainer.innerHTML = `<p class="text-xs text-red-400">Failed to load explanations.</p>`;
        }
      }

      // Initial execution
      initCategoryBreakdownAndReview();

      btnReview.addEventListener('click', () => {
        reviewSection.classList.toggle('hidden');
        if (!reviewSection.classList.contains('hidden')) {
          reviewSection.scrollIntoView({ behavior: 'smooth' });
        }
      });

      // Bookmarked review logic
      const btnBookmarks = document.getElementById('btn-bookmarks');
      const bookmarksSection = document.getElementById('bookmarks-section');
      const bookmarksContainer = document.getElementById('bookmarks-container');

      function renderBookmarks() {
        const bookmarks = JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]');
        if (bookmarks.length === 0) {
          bookmarksContainer.innerHTML = `<p class="text-xs text-stone-500">You haven't bookmarked any questions yet.</p>`;
          return;
        }

        bookmarksContainer.innerHTML = '';
        bookmarks.forEach((q, idx) => {
          const qCard = document.createElement('div');
          qCard.className = "p-4 rounded-lg bg-stone-900/40 border border-stone-850 space-y-2 relative";

          const optionStates = [1, 2, 3, 4].map(optNum => {
            const text = q[`option${optNum}`];
            const isCorrect = q.correct_option === optNum;
            let styleClass = isCorrect ? "text-emerald-400 font-medium" : "text-stone-400";
            let indicator = isCorrect ? "✅" : "•";
            return `<p class="${styleClass}">${indicator} ${text}</p>`;
          }).join('');

          const explanationHtml = q.explanation
            ? `<div class="mt-3 p-3 bg-amber-950/20 border-l-2 border-amber-500/50 rounded text-xs text-amber-200">
                 <strong>Explanation:</strong> ${q.explanation}
               </div>`
            : '';

          qCard.innerHTML = `
            <div class="flex justify-between items-start gap-2">
              <p class="text-sm font-semibold text-stone-200">${idx + 1}. ${q.question}</p>
              <button class="unbookmark-btn text-red-400 hover:text-red-300 text-xs font-semibold px-2 py-1 rounded bg-red-950/30 border border-red-900/40 flex-shrink-0" data-id="${q.id}">
                Remove
              </button>
            </div>
            <div class="text-xs pl-4 space-y-1 mt-2">
              ${optionStates}
            </div>
            ${explanationHtml}
          `;

          qCard.querySelector('.unbookmark-btn').addEventListener('click', () => {
            let updated = JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]');
            updated = updated.filter(item => item.id !== q.id);
            localStorage.setItem('bookmarkedQuestions', JSON.stringify(updated));
            renderBookmarks();
          });

          bookmarksContainer.appendChild(qCard);
        });
      }

      if (btnBookmarks) {
        btnBookmarks.addEventListener('click', () => {
          bookmarksSection.classList.toggle('hidden');
          if (!bookmarksSection.classList.contains('hidden')) {
            renderBookmarks();
            bookmarksSection.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }
      function initThemeToggle() {
        const toggleBtn = document.createElement('button');
        toggleBtn.id = 'theme-toggle';
        toggleBtn.className = 'fixed top-4 right-4 bg-stone-900/80 hover:bg-stone-800 text-stone-200 p-3 rounded-full border border-stone-800 hover:border-stone-700 shadow-lg active:scale-95 transition z-50 text-xl w-12 h-12 flex items-center justify-center';
        toggleBtn.setAttribute('aria-label', 'Toggle theme');
        
        const isLight = document.documentElement.classList.contains('theme-light');
        toggleBtn.textContent = isLight ? '🌙' : '☀️';

        document.body.appendChild(toggleBtn);

        toggleBtn.addEventListener('click', () => {
          const currentlyLight = document.documentElement.classList.contains('theme-light');
          if (currentlyLight) {
            document.documentElement.classList.remove('theme-light');
            localStorage.setItem('theme', 'dark');
            toggleBtn.textContent = '☀️';
          } else {
            document.documentElement.classList.add('theme-light');
            localStorage.setItem('theme', 'light');
            toggleBtn.textContent = '🌙';
          }
        });
      }

      initThemeToggle();
    });
  </script>
</body>

</html>
