    function updateTopicDetails(sectionId) {
      const container = document.getElementById('topic-details-container');
      const difficultyEl = document.getElementById('topic-detail-difficulty');
      const questionsEl = document.getElementById('topic-detail-questions');
      const accuracyEl = document.getElementById('topic-detail-accuracy');
      
      if (!container || !difficultyEl || !questionsEl || !accuracyEl) return;
      
      if (!sectionId) {
        container.classList.add('hidden');
        return;
      }
      
      const section = allSectionsList.find(s => s.id == sectionId);
      if (!section) {
        container.classList.add('hidden');
        return;
      }
      
      difficultyEl.textContent = section.difficulty || 'All Levels';
      questionsEl.textContent = section.questionCount || 5;
      
      const history = JSON.parse(localStorage.getItem('quizHistory') || '[]');
      const attempts = history.filter(item => item.sectionId == sectionId);
      
      if (attempts.length > 0) {
        let totalAccuracy = 0;
        attempts.forEach(item => {
          const score = item.score || 0;
          const total = item.total || 5;
          totalAccuracy += (score / total) * 100;
        });
        const avgAccuracy = Math.round(totalAccuracy / attempts.length);
        accuracyEl.textContent = `${avgAccuracy}% (${attempts.length} attempts)`;
        accuracyEl.className = "font-semibold text-emerald-400";
      } else {
        accuracyEl.textContent = "Unattempted";
        accuracyEl.className = "font-semibold text-stone-500 italic";
      }
      
      container.classList.remove('hidden');
    }

