         importProgressFile.click();
       });
       importProgressFile.addEventListener('change', (e) => {
         const file = e.target.files[0];
         if (!file) return;
         const reader = new FileReader();
         reader.onload = function(evt) {
           const decrypted = decryptData(evt.target.result.trim());
           if (!decrypted) {
             alert("Error: Tampered or invalid progress backup file!");
             return;
           }
           try {
             const payload = JSON.parse(decrypted);
             if (!payload || typeof payload !== 'object' || !payload.quizHistory) {
               throw new Error("Invalid structure");
             }
             if (payload.quizHistory) localStorage.setItem('quizHistory', JSON.stringify(payload.quizHistory.slice(0, 50)));
             if (payload.sm2Data) localStorage.setItem('sm2Data', JSON.stringify(payload.sm2Data));
             if (payload.userName) localStorage.setItem('userName', payload.userName);
             if (payload.soundEnabled !== undefined) localStorage.setItem('soundEnabled', payload.soundEnabled);
             if (payload.vibrationEnabled !== undefined) localStorage.setItem('vibrationEnabled', payload.vibrationEnabled);
             
             alert("Progress imported successfully! App will now refresh.");
             window.location.reload();
           } catch(err) {
             alert("Error: Tampered or invalid progress backup file structure!");
           }
         };
         reader.readAsText(file);
         importProgressFile.value = ''; // Reset input
       });
     }

