        <!-- Cloud Account Sync -->
        <div class="p-6 bg-stone-900/40 border border-stone-850 rounded-2xl space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-stone-850">
            <span class="text-lg">☁️</span>
            <h3 class="text-sm font-bold text-stone-300 tracking-wide uppercase">Cloud Account Sync</h3>
