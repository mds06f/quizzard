            <textarea id="ai-notes" rows="4" maxlength="500" class="neon-border block w-full p-4 border border-stone-800 bg-stone-950/45 text-stone-100 rounded-lg placeholder-stone-600 focus:outline-none text-xs resize-none" placeholder="Paste study notes here (minimum 50 characters, max 500)..." required></textarea>
