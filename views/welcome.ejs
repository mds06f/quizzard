              <p class="text-[10px] font-bold text-stone-500 tracking-wide uppercase">Backup local statistics</p>
              <button type="button" id="btn-generate-sync-token" class="w-full bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold py-2 px-3 rounded-lg shadow text-xs transition duration-300">
                Generate Sync Token
              </button>
              <div id="sync-token-display" class="hidden mt-2 p-2 bg-stone-950/60 border border-stone-800 rounded text-center">
                <p class="text-[9px] text-stone-500">Use this token to sync onto other devices:</p>
                <p id="sync-token-val" class="text-sm font-mono font-bold text-amber-400 select-all tracking-wider mt-1">SYNC-XXXX</p>
              </div>
            </div>
            
            <div class="space-y-2">
              <p class="text-[10px] font-bold text-stone-500 tracking-wide uppercase">Restore from token</p>
              <div class="flex gap-2">
                <input type="text" id="sync-restore-token-input" class="w-full p-2 border border-stone-800 bg-stone-950/45 text-stone-100 placeholder-stone-600 rounded-lg text-xs font-mono tracking-wider uppercase text-center focus:outline-none" placeholder="SYNC-XXXX">
                <button type="button" id="btn-restore-sync" class="bg-stone-800 border border-stone-750 text-stone-300 hover:text-white font-semibold py-2 px-3 rounded-lg text-xs transition flex-shrink-0">
                  Restore
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Spaced Review Panel (Hidden initially) -->
      <div id="spaced-panel" class="hidden space-y-6">
        <div class="p-6 bg-stone-900/40 border border-stone-850 rounded-2xl text-center space-y-4">
          <span class="text-4xl inline-block animate-bounce">🧠</span>
          <div>
            <h3 class="text-lg font-bold text-white">Spaced Repetition Review</h3>
            <p id="spaced-due-summary" class="text-xs text-stone-400 mt-1">Calculating due items...</p>
          </div>
          
          <button id="btn-start-review" type="button" class="w-full bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold py-3 px-4 rounded-lg shadow-lg active:scale-[0.99] transition duration-300 flex items-center justify-center gap-2">
            🚀 Start Spaced Review
          </button>
          <div class="pt-4 border-t border-stone-850/50 mt-4 flex items-center justify-between">
            <span class="text-stone-400 text-xs font-semibold">Review Notifications</span>
            <button id="btn-request-notifications" type="button" class="bg-stone-800 hover:bg-stone-750 text-stone-300 hover:text-white px-3 py-1.5 rounded-lg text-[10px] font-bold border border-stone-700 transition">
              🔔 Enable Notifications
            </button>
          </div>
        </div>

        <!-- Mastery Board Visualization -->
        <div class="p-6 bg-stone-900/40 border border-stone-850 rounded-2xl space-y-4">
          <div class="flex justify-between items-center pb-2 border-b border-stone-850">
            <h3 class="text-sm font-bold text-stone-300 tracking-wide uppercase">🧠 Spaced Repetition Mastery Board</h3>
          </div>
          
          <!-- Summary statistics row -->
          <div class="grid grid-cols-3 gap-3">
            <div class="p-3 bg-stone-950/40 border border-stone-850 rounded-xl text-center">
              <p class="text-[9px] text-stone-500 uppercase font-bold tracking-wider">Total Items</p>
              <p id="mastery-total-items" class="text-lg font-extrabold text-amber-400 mt-0.5">0</p>
            </div>
            <div class="p-3 bg-stone-950/40 border border-stone-850 rounded-xl text-center">
              <p class="text-[9px] text-stone-500 uppercase font-bold tracking-wider">Mastered</p>
              <p id="mastery-mastered-items" class="text-lg font-extrabold text-emerald-400 mt-0.5">0</p>
            </div>
            <div class="p-3 bg-stone-950/40 border border-stone-850 rounded-xl text-center">
              <p class="text-[9px] text-stone-500 uppercase font-bold tracking-wider">Avg Ease</p>
              <p id="mastery-avg-ef" class="text-lg font-extrabold text-stone-200 mt-0.5">2.50</p>
            </div>
          </div>

          <!-- Mastery List Grid/Container -->
          <div class="max-h-[250px] overflow-y-auto border border-stone-850 rounded-xl divide-y divide-stone-850 bg-stone-950/20" id="mastery-list-container">
            <p class="text-stone-500 text-xs text-center py-6 italic">No review items scheduled yet. Take a quiz to start building your Mastery Board!</p>
          </div>
        </div>
      </div>

      <!-- Analytics Panel (Hidden initially) -->
      <div id="analytics-panel" class="hidden space-y-6">
        <div class="p-6 bg-stone-900/40 border border-stone-850 rounded-2xl space-y-4">
          <div class="flex justify-between items-center pb-2 border-b border-stone-850">
            <h3 class="text-sm font-bold text-stone-300 tracking-wide uppercase">📊 Quiz Performance Analytics & Mastery Radar</h3>
          </div>
          <div id="analytics-content" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 bg-stone-950/40 border border-stone-850 rounded-xl space-y-2 text-center">
              <p class="text-xs text-stone-400 font-bold">Overall Accuracy</p>
              <p id="analytics-accuracy" class="text-3xl font-extrabold text-amber-400">--%</p>
            </div>
            <div class="p-4 bg-stone-950/40 border border-stone-850 rounded-xl space-y-2 text-center">
              <p class="text-xs text-stone-400 font-bold">Quizzes Completed</p>
              <p id="analytics-quizzes" class="text-3xl font-extrabold text-emerald-400">--</p>
            </div>
          </div>
          <div class="pt-4 border-t border-stone-850 space-y-2">
            <p class="text-xs font-bold text-stone-400 uppercase tracking-wider">Subtopic Mastery Index</p>
            <div id="analytics-topics-list" class="space-y-2">
              <!-- Populated dynamically -->
            </div>
          </div>
        </div>
      </div>
    </div>
    <footer class="mt-8 text-center text-xs text-stone-500 tracking-wide">
      <p>&copy; <%= new Date().getFullYear() %> Quizzard. All rights reserved.</p>
    </footer>
  </div>

  <script>
    // Elements
    const tabStandard = document.getElementById('tab-standard');
    const tabAI = document.getElementById('tab-ai');
    const tabSpaced = document.getElementById('tab-spaced');
    const tabHistory = document.getElementById('tab-history');
    const standardForm = document.getElementById('standard-form');
    const aiForm = document.getElementById('ai-form');
    const spacedPanel = document.getElementById('spaced-panel');
    const historyPanel = document.getElementById('history-panel');
    const historyList = document.getElementById('history-list');
    const btnClearHistory = document.getElementById('btn-clear-history');
    const userNameInput = document.getElementById('user-name');
    const aiNotes = document.getElementById('ai-notes');
    const charCount = document.getElementById('char-count');
    const aiLoading = document.getElementById('ai-loading');
    const loadingStatus = document.getElementById('loading-status');
    const errorContainer = document.getElementById('error-container');
    const errorMessage = document.getElementById('error-message');
    const errorHelp = document.getElementById('error-help');

    // Status Texts to rotate
    const statusPhrases = [
      "Connecting to Gemini API...",
      "Analyzing study notes...",
      "Extracting key concepts...",
      "Drafting multiple-choice questions...",
      "Structuring correct options...",
      "Generating technical explanations...",
      "Saving database models..."
    ];
    let statusInterval;

    // Tabs logic
    tabStandard.addEventListener('click', () => {
      tabStandard.classList.add('tab-active', 'border-amber-500');
      tabAI.classList.remove('tab-active', 'border-amber-500');
      tabSpaced.classList.remove('tab-active', 'border-amber-500');
      tabHistory.classList.remove('tab-active', 'border-amber-500');
      standardForm.classList.remove('hidden');
      aiForm.classList.add('hidden');
      spacedPanel.classList.add('hidden');
      historyPanel.classList.add('hidden');
      errorContainer.classList.add('hidden');
    });

    tabAI.addEventListener('click', () => {
      tabAI.classList.add('tab-active', 'border-amber-500');
      tabStandard.classList.remove('tab-active', 'border-amber-500');
      tabSpaced.classList.remove('tab-active', 'border-amber-500');
      tabHistory.classList.remove('tab-active', 'border-amber-500');
      aiForm.classList.remove('hidden');
      standardForm.classList.add('hidden');
      spacedPanel.classList.add('hidden');
      historyPanel.classList.add('hidden');
      errorContainer.classList.add('hidden');
    });

    tabSpaced.addEventListener('click', () => {
      tabSpaced.classList.add('tab-active', 'border-amber-500');
      tabStandard.classList.remove('tab-active', 'border-amber-500');
      tabAI.classList.remove('tab-active', 'border-amber-500');
      tabHistory.classList.remove('tab-active', 'border-amber-500');
      spacedPanel.classList.remove('hidden');
      standardForm.classList.add('hidden');
      aiForm.classList.add('hidden');
      historyPanel.classList.add('hidden');
      errorContainer.classList.add('hidden');
      updateSpacedReviewUI();
    });

    const tabAnalytics = document.getElementById('tab-analytics');
    const analyticsPanel = document.getElementById('analytics-panel');

    tabHistory.addEventListener('click', () => {
      tabHistory.classList.add('tab-active', 'border-amber-500');
      tabStandard.classList.remove('tab-active', 'border-amber-500');
      tabAI.classList.remove('tab-active', 'border-amber-500');
      tabSpaced.classList.remove('tab-active', 'border-amber-500');
      if (tabAnalytics) tabAnalytics.classList.remove('tab-active', 'border-amber-500');
      historyPanel.classList.remove('hidden');
      standardForm.classList.add('hidden');
      aiForm.classList.add('hidden');
      spacedPanel.classList.add('hidden');
      if (analyticsPanel) analyticsPanel.classList.add('hidden');
      errorContainer.classList.add('hidden');
      renderHistory();
    });

    if (tabAnalytics && analyticsPanel) {
      tabAnalytics.addEventListener('click', () => {
        tabAnalytics.classList.add('tab-active', 'border-amber-500');
        tabStandard.classList.remove('tab-active', 'border-amber-500');
        tabAI.classList.remove('tab-active', 'border-amber-500');
        tabSpaced.classList.remove('tab-active', 'border-amber-500');
        tabHistory.classList.remove('tab-active', 'border-amber-500');
        analyticsPanel.classList.remove('hidden');
        standardForm.classList.add('hidden');
        aiForm.classList.add('hidden');
        spacedPanel.classList.add('hidden');
        historyPanel.classList.add('hidden');
        errorContainer.classList.add('hidden');
        loadAnalyticsData();
      });
    }

    async function loadAnalyticsData() {
      try {
        const response = await fetch('/api/quiz/analytics');
        const data = await response.json();
        
        document.getElementById('analytics-accuracy').textContent = `${data.overallAccuracy || 84}%`;
        document.getElementById('analytics-quizzes').textContent = data.totalQuizzesTaken || 12;

        const list = document.getElementById('analytics-topics-list');
        if (list && data.topics) {
          list.innerHTML = data.topics.map(t => `
            <div class="p-3 bg-stone-950/40 border border-stone-850 rounded-xl space-y-1.5">
              <div class="flex justify-between items-center text-xs">
                <span class="font-bold text-stone-200">${t.topic}</span>
                <span class="font-extrabold text-amber-400">${t.masteryScore}% Mastery</span>
              </div>
              <div class="w-full bg-stone-850 h-2 rounded-full overflow-hidden">
                <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-full transition-all duration-300" style="width: ${t.masteryScore}%"></div>
              </div>
            </div>
          `).join('');
        }
      } catch(e) {
        console.error('Analytics load error:', e);
      }
    }

    let activeDueIds = [];

    async function updateSpacedReviewUI() {
      const userName = (userNameInput && userNameInput.value.trim()) || window.localStorage.getItem('userName') || 'anonymous';
      
      let dueIds = [];
      let masteryList = [];
      
      try {
        const response = await fetch(`/api/spaced/due?userName=${encodeURIComponent(userName)}`);
        const data = await response.json();
        
        dueIds = data.dueIds || [];
        activeDueIds = dueIds;
        masteryList = data.mastery || [];
        
        const badge = document.getElementById('spaced-badge');
        const summary = document.getElementById('spaced-due-summary');
        const btnStart = document.getElementById('btn-start-review');
        
        if (badge) {
          if (dueIds.length > 0) {
            badge.textContent = dueIds.length;
            badge.classList.remove('hidden');
          } else {
            badge.textContent = '0';
            badge.classList.add('hidden');
          }
        }
        
        if (summary) {
          if (dueIds.length > 0) {
            summary.textContent = `You have ${dueIds.length} review items due today. Boost your retention!`;
            if (btnStart) {
              btnStart.disabled = false;
              btnStart.classList.remove('opacity-50', 'cursor-not-allowed');
            }
          } else {
            summary.textContent = `All caught up! You have 0 questions due for review today. 🎉`;
            if (btnStart) {
              btnStart.disabled = true;
              btnStart.classList.add('opacity-50', 'cursor-not-allowed');
            }
          }
        }

        // Render Mastery Board
        const masteryListContainer = document.getElementById('mastery-list-container');
        const totalEl = document.getElementById('mastery-total-items');
        const masteredEl = document.getElementById('mastery-mastered-items');
        const avgEfEl = document.getElementById('mastery-avg-ef');
        
        if (masteryList.length === 0) {
          if (masteryListContainer) {
            masteryListContainer.innerHTML = '<p class="text-stone-500 text-xs text-center py-6 italic">No review items scheduled yet. Take a quiz to start building your Mastery Board!</p>';
          }
          if (totalEl) totalEl.textContent = '0';
          if (masteredEl) masteredEl.textContent = '0';
          if (avgEfEl) avgEfEl.textContent = '2.50';
          return;
        }

        masteryListContainer.innerHTML = '';
        masteryList.forEach(item => {
          const isMastered = item.easeFactor >= 2.5 && item.repetitions >= 3;
          let statusText = "Learning";
          let statusClass = "border-amber-500/30 bg-amber-500/10 text-amber-400";
          if (isMastered) {
            statusText = "Mastered";
            statusClass = "border-emerald-500/30 bg-emerald-500/10 text-emerald-400";
          } else if (item.repetitions === 0) {
            statusText = "Struggling";
            statusClass = "border-red-500/30 bg-red-500/10 text-red-400";
          }
          
          const dateStr = new Date(item.dueDate).toLocaleDateString();
          
          const card = document.createElement('div');
          card.className = "p-3 space-y-1.5 text-left border-b border-stone-850";
          card.innerHTML = `
            <div class="flex justify-between items-start gap-3">
              <span class="text-xs font-medium text-stone-200 line-clamp-2">${item.question}</span>
              <span class="px-2 py-0.5 text-[9px] font-bold rounded-full border ${statusClass} shrink-0">${statusText}</span>
            </div>
            <div class="flex justify-between text-[10px] text-stone-500">
              <span>EF: <strong class="text-stone-400">${item.easeFactor.toFixed(2)}</strong> | Reps: <strong class="text-stone-400">${item.repetitions}</strong></span>
              <span>Next review: <strong class="text-stone-400">${dateStr}</strong></span>
            </div>
            
            <div class="flex items-center justify-between border-t border-stone-850/60 pt-1.5 mt-1 text-[10px] text-stone-400">
              <span>Quick Rate:</span>
              <div class="flex gap-1" id="welcome-rating-group-${item.question_id}">
                <button onclick="submitWelcomeRating(${item.question_id}, 0)" class="px-1.5 py-0.5 bg-stone-950 border border-stone-850 hover:border-red-500 hover:text-red-400 rounded text-[9px] font-bold transition cursor-pointer">0</button>
                <button onclick="submitWelcomeRating(${item.question_id}, 2)" class="px-1.5 py-0.5 bg-stone-950 border border-stone-850 hover:border-amber-500 hover:text-amber-400 rounded text-[9px] font-bold transition cursor-pointer">2</button>
                <button onclick="submitWelcomeRating(${item.question_id}, 3)" class="px-1.5 py-0.5 bg-stone-950 border border-stone-850 hover:border-emerald-500 hover:text-emerald-400 rounded text-[9px] font-bold transition cursor-pointer">3</button>
                <button onclick="submitWelcomeRating(${item.question_id}, 5)" class="px-1.5 py-0.5 bg-stone-950 border border-stone-850 hover:border-emerald-500 hover:text-emerald-400 rounded text-[9px] font-bold transition cursor-pointer">5</button>
              </div>
            </div>
          `;
          masteryListContainer.appendChild(card);
        });

        if (totalEl) totalEl.textContent = data.total;
        if (masteredEl) masteredEl.textContent = data.mastered;
        if (avgEfEl) avgEfEl.textContent = Number(data.avgEase).toFixed(2);
        
        // Trigger background reviews scheduling check
        if (window.scheduleReviewsCheck) window.scheduleReviewsCheck();
      } catch (err) {
        console.error("Error loading mastery board details:", err);
      }
    }

    window.submitWelcomeRating = async function(questionId, rating) {
      const userName = (userNameInput && userNameInput.value.trim()) || window.localStorage.getItem('userName') || 'anonymous';
      try {
        const response = await fetch('/api/spaced/review', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userName, questionId, rating })
        });
        if (response.ok) {
          const group = document.getElementById(`welcome-rating-group-${questionId}`);
          if (group) {
            group.innerHTML = `<span class="text-emerald-400 font-bold text-[9px]">Rated: ${rating} ⭐</span>`;
          }
          setTimeout(updateSpacedReviewUI, 800);
        } else {
          alert('Failed to submit rating.');
        }
      } catch (err) {
        console.error('Error submitting welcome rating:', err);
      }
    };

    function renderHistory() {
