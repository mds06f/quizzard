          const count = await window.offlineSync.getPendingSyncCount();
          if (count > 0) {
            syncCountEl.textContent = count;
            syncBadge.classList.remove('hidden');
          } else {
            syncBadge.classList.add('hidden');
          }
        } catch (err) {
          console.error('Failed to load pending sync count:', err);
        }
      }
    }

    function updateOnlineStatus() {
      if (navigator.onLine) {
        offlineBadge.classList.add('hidden');
        if (window.offlineSync) {
          window.offlineSync.getPendingSyncs().then(async (attempts) => {
            if (attempts.length > 0) {
              console.log('[Offline Sync] Online detected. Performing manual sync fallback...');
              try {
                const response = await fetch('/api/quiz/user/sync', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ attempts })
                });
                if (response.ok) {
                  const ids = attempts.map(a => a.id);
                  await window.offlineSync.removePendingSyncs(ids);
                  console.log('[Offline Sync] Manual sync fallback succeeded.');
                  updateSyncCount();
                }
              } catch (e) {
                console.warn('[Offline Sync] Manual sync fallback failed:', e);
              }
            }
          });
        }
      } else {
        offlineBadge.classList.remove('hidden');
      }
    }

    window.addEventListener('online', () => {
      updateOnlineStatus();
      updateSyncCount();
    });
    window.addEventListener('offline', () => {
      updateOnlineStatus();
      updateSyncCount();
    });

    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.addEventListener('message', (event) => {
        if (event.data && event.data.type === 'SYNC_STATUS_UPDATE') {
          console.log('[Client] Received sync status update from Service Worker:', event.data.pendingCount);
          const count = event.data.pendingCount;
          if (count > 0) {
            syncCountEl.textContent = count;
            syncBadge.classList.remove('hidden');
          } else {
            syncBadge.classList.add('hidden');
          }
        }
      });
    }

    // Run on startup
    document.addEventListener('DOMContentLoaded', () => {
      updateOnlineStatus();
      updateSyncCount();
    });

    // Service Worker Registration and PWA Install prompt
    let deferredPrompt;
    
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then((reg) => console.log('Service Worker registered successfully:', reg.scope))
          .catch((err) => console.error('Service Worker registration failed:', err));
      });
    }

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      const installBanner = document.getElementById('pwa-install-banner');
      if (installBanner) {
        installBanner.classList.remove('hidden');
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      const btnPwaInstall = document.getElementById('btn-pwa-install');
      const btnPwaDismiss = document.getElementById('btn-pwa-dismiss');
      const installBanner = document.getElementById('pwa-install-banner');

      if (btnPwaInstall && btnPwaDismiss && installBanner) {
        btnPwaInstall.addEventListener('click', () => {
          if (!deferredPrompt) return;
          deferredPrompt.prompt();
          deferredPrompt.userChoice.then((choiceResult) => {
            if (choiceResult.outcome === 'accepted') {
              console.log('User accepted the install prompt');
            } else {
              console.log('User dismissed the install prompt');
            }
            deferredPrompt = null;
            installBanner.classList.add('hidden');
          });
        });

        btnPwaDismiss.addEventListener('click', () => {
          installBanner.classList.add('hidden');
        });
      }
    });

    // Init
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize settings checkboxes
      const settingsSound = document.getElementById('settings-sound');
      const settingsVibration = document.getElementById('settings-vibration');
      
      if (settingsSound) {
        settingsSound.checked = localStorage.getItem('soundEnabled') !== 'false';
        settingsSound.addEventListener('change', (e) => {
          localStorage.setItem('soundEnabled', e.target.checked ? 'true' : 'false');
        });
      }
      
      if (settingsVibration) {
        settingsVibration.checked = localStorage.getItem('vibrationEnabled') !== 'false';
        settingsVibration.addEventListener('change', (e) => {
          localStorage.setItem('vibrationEnabled', e.target.checked ? 'true' : 'false');
        });
      }

      // Bind topic search field
      const topicSearch = document.getElementById('topic-search');
      const btnClearSearch = document.getElementById('btn-clear-search');
      if (topicSearch && btnClearSearch) {
        topicSearch.addEventListener('input', (e) => {
          const val = e.target.value.trim();
          if (val.length > 0) {
            btnClearSearch.classList.remove('hidden');
          } else {
            btnClearSearch.classList.add('hidden');
          }
          renderFilteredSections(val);
        });

        btnClearSearch.addEventListener('click', () => {
          topicSearch.value = '';
          btnClearSearch.classList.add('hidden');
          renderFilteredSections('');
          topicSearch.focus();
        });
      }

      // Bind special gameplay mode select descriptions
      const specialModeSelect = document.getElementById('special-mode-select');
      const specialModeDescContainer = document.getElementById('special-mode-desc-container');
      const specialModeDescText = document.getElementById('special-mode-desc-text');

      function updateSpecialModeDesc(value) {
        if (!specialModeSelect || !specialModeDescContainer || !specialModeDescText) return;
        
        if (value === 'sudden-death') {
          specialModeDescText.textContent = "💀 Sudden Death Mode: Get one question wrong and the quiz ends instantly!";
          specialModeDescContainer.classList.remove('hidden');
        } else if (value === 'flashcards') {
          specialModeDescText.textContent = "🎴 Flashcard Practice: Review concepts dynamically by flipping cards, self-rating answers, and practicing spaced repetition without a timer or scores.";
          specialModeDescContainer.classList.remove('hidden');
        } else {
          specialModeDescContainer.classList.add('hidden');
          specialModeDescText.textContent = "";
        }
      }

      if (specialModeSelect) {
        updateSpecialModeDesc(specialModeSelect.value);
        specialModeSelect.addEventListener('change', (e) => {
          updateSpecialModeDesc(e.target.value);
        });
      }

      // Initialize theme toggler
      initThemeToggle();

      // Cloud sync token actions
      const btnGenToken = document.getElementById('btn-generate-sync-token');
      const syncTokenDisplay = document.getElementById('sync-token-display');
      const syncTokenVal = document.getElementById('sync-token-val');
      
      if (btnGenToken && syncTokenDisplay && syncTokenVal) {
        btnGenToken.addEventListener('click', async () => {
          const payload = {
            quizHistory: JSON.parse(localStorage.getItem('quizHistory') || '[]'),
            sm2Data: JSON.parse(localStorage.getItem('sm2Data') || '{}'),
            streakData: JSON.parse(localStorage.getItem('streakData') || '{}'),
            userName: localStorage.getItem('userName') || '',
            theme: localStorage.getItem('theme') || 'dark',
            soundEnabled: localStorage.getItem('soundEnabled') || 'true',
            vibrationEnabled: localStorage.getItem('vibrationEnabled') || 'true',
            soundWaveform: localStorage.getItem('soundWaveform') || 'sine'
          };
          
          try {
            const response = await fetch('/api/quiz/user/sync/token', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ payload })
            });
            const data = await response.json();
            if (data.token) {
              syncTokenVal.textContent = data.token;
              syncTokenDisplay.classList.remove('hidden');
            } else {
              alert("Failed to generate token.");
            }
          } catch (err) {
            console.error("Error backing up data:", err);
            alert("Error backing up data to cloud.");
          }
        });
      }
      
      const btnRestoreSync = document.getElementById('btn-restore-sync');
      const restoreInput = document.getElementById('sync-restore-token-input');
      if (btnRestoreSync && restoreInput) {
        btnRestoreSync.addEventListener('click', async () => {
          const token = restoreInput.value.trim();
          if (!token) {
            alert("Please enter a valid sync token.");
            return;
          }
          
          if (!confirm("Restoring will overwrite all local history and settings on this device. Do you want to continue?")) {
            return;
          }
          
          try {
            const response = await fetch(`/api/quiz/user/sync/restore/${encodeURIComponent(token)}`);
            if (response.status === 404) {
              alert("Invalid or expired sync token.");
              return;
            }
            const data = await response.json();
            const payload = data.payload;
            if (payload) {
              if (payload.quizHistory) localStorage.setItem('quizHistory', JSON.stringify(payload.quizHistory.slice(0, 50)));
              if (payload.sm2Data) localStorage.setItem('sm2Data', JSON.stringify(payload.sm2Data));
              if (payload.streakData) localStorage.setItem('streakData', JSON.stringify(payload.streakData));
              if (payload.userName) localStorage.setItem('userName', payload.userName);
              if (payload.theme) localStorage.setItem('theme', payload.theme);
              if (payload.soundEnabled) localStorage.setItem('soundEnabled', payload.soundEnabled);
              if (payload.vibrationEnabled) localStorage.setItem('vibrationEnabled', payload.vibrationEnabled);
              if (payload.soundWaveform) localStorage.setItem('soundWaveform', payload.soundWaveform);
              
              alert("Restored data successfully! App will now refresh.");
              window.location.reload();
            } else {
              alert("Invalid payload format returned.");
            }
          } catch (err) {
            console.error("Error restoring data:", err);
            alert("Error restoring data from cloud.");
          }
        });
      }

      // Multiplayer Mode toggler
      window.multiplayerMode = 'competitive';
      const btnComp = document.getElementById('btn-multi-mode-competitive');
      const btnCoop = document.getElementById('btn-multi-mode-cooperative');
      if (btnComp && btnCoop) {
        btnComp.addEventListener('click', () => {
          window.multiplayerMode = 'competitive';
          btnComp.className = "px-3 py-1 text-[10px] font-bold rounded bg-amber-600 text-white transition cursor-pointer";
          btnCoop.className = "px-3 py-1 text-[10px] font-bold rounded text-stone-400 hover:text-stone-200 transition cursor-pointer";
        });
        btnCoop.addEventListener('click', () => {
          window.multiplayerMode = 'cooperative';
          btnCoop.className = "px-3 py-1 text-[10px] font-bold rounded bg-amber-600 text-white transition cursor-pointer";
          btnComp.className = "px-3 py-1 text-[10px] font-bold rounded text-stone-400 hover:text-stone-200 transition cursor-pointer";
        });
      }

      // Initialize settings waveform select
      const settingsWaveform = document.getElementById('settings-waveform');
      if (settingsWaveform) {
        settingsWaveform.value = localStorage.getItem('soundWaveform') || 'sine';
        settingsWaveform.addEventListener('change', (e) => {
          localStorage.setItem('soundWaveform', e.target.value);
        });
      }

      // Initialize settings volume slider
      const settingsVolume = document.getElementById('settings-volume');
      const volumeLabel = document.getElementById('volume-value-label');
      if (settingsVolume) {
        const storedVol = localStorage.getItem('soundVolume') || '100';
        settingsVolume.value = storedVol;
        if (volumeLabel) volumeLabel.textContent = `${storedVol}%`;
        
        settingsVolume.addEventListener('input', (e) => {
          const vol = e.target.value;
          localStorage.setItem('soundVolume', vol);
          if (volumeLabel) volumeLabel.textContent = `${vol}%`;
        });
      }

      // Bind topic details updates
      const sectionSelect = document.getElementById('section-select');
      if (sectionSelect) {
        sectionSelect.addEventListener('change', (e) => {
          updateTopicDetails(e.target.value);
        });
      }

      // Streak validation
      const streakDataRaw = localStorage.getItem('streakData');
      const container = document.getElementById('streak-badge-container');
      const countEl = document.getElementById('streak-count');
      
      if (streakDataRaw) {
        try {
          const data = JSON.parse(streakDataRaw);
          if (data.lastDate) {
            const today = new Date();
            today.setHours(0,0,0,0);
            const last = new Date(data.lastDate);
            last.setHours(0,0,0,0);
            
            const diffTime = Math.abs(today - last);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            if (diffDays > 1) {
              data.streak = 0;
              data.lastDate = null;
              localStorage.setItem('streakData', JSON.stringify(data));
            }
          }
          if (data.streak > 0) {
            countEl.textContent = data.streak;
            container.classList.remove('hidden');
          } else {
            container.classList.add('hidden');
          }
        } catch (e) {
          console.error("Error loading streak data", e);
        }
      }

      // Default Active Tab styling
      tabStandard.classList.add('tab-active', 'border-amber-500');

      const savedUserName = window.localStorage.getItem('userName');
      if (savedUserName) {
        userNameInput.value = savedUserName;
      }

      const savedDifficulty = window.localStorage.getItem('difficulty');
      if (savedDifficulty) {
        document.getElementById('difficulty-select').value = savedDifficulty;
      }

      // Auto-calibrate difficulty from history
      function autoCalibrateDifficulty() {
        const history = JSON.parse(localStorage.getItem('quizHistory') || '[]');
        if (history.length === 0) {
          const lbl = document.getElementById('calibrated-difficulty-lbl');
          if (lbl) lbl.textContent = 'Medium (No history)';
          return;
        }

        let totalScore = 0;
        let totalQuestions = 0;
        history.forEach(attempt => {
          totalScore += attempt.score;
          totalQuestions += attempt.total;
        });

        if (totalQuestions === 0) return;
        const ratio = totalScore / totalQuestions;

        let calibrated = 'medium';
        if (ratio >= 0.8) {
          calibrated = 'hard';
        } else if (ratio < 0.5) {
          calibrated = 'easy';
        }

        const select = document.getElementById('ai-difficulty-select');
        const label = document.getElementById('calibrated-difficulty-lbl');
        
        if (select) {
          select.value = calibrated;
        }
        if (label) {
          const capitalized = calibrated.charAt(0).toUpperCase() + calibrated.slice(1);
          label.textContent = `${capitalized} (${Math.round(ratio * 100)}% avg accuracy)`;
        }
      }

      autoCalibrateDifficulty();

      updateSpacedReviewUI();

      // Bind Spaced Repetition action
      document.getElementById('btn-start-review').addEventListener('click', () => {
        if (activeDueIds.length === 0) return;
        
        const dueCopy = [...activeDueIds];
        dueCopy.sort(() => 0.5 - Math.random());
        const selectedReviewIds = dueCopy.slice(0, 10);
        
        const userName = userNameInput.value.trim() || 'Reviewer';
        window.localStorage.setItem('userName', userName);
        window.localStorage.setItem('activeReviewQuestionIds', JSON.stringify(selectedReviewIds));
        window.localStorage.setItem('challengeMode', 'false');
        
        window.location.href = `/quiz?review=true`;
      });

      // Request notifications permission and register scheduling
      const btnRequestNotifications = document.getElementById('btn-request-notifications');
      
      window.scheduleReviewsCheck = function() {
        if (!('Notification' in window) || Notification.permission !== 'granted') return;
        if (!navigator.serviceWorker || !navigator.serviceWorker.controller) return;
        
        const dueCount = activeDueIds.length;
        if (dueCount > 0) {
          navigator.serviceWorker.controller.postMessage({
            type: 'SCHEDULE_REVIEWS_CHECK',
            nextDueTime: Date.now(), // Trigger notification check
            dueCount: dueCount
          });
        }
      };

      if (btnRequestNotifications) {
        if (Notification.permission === 'granted') {
          btnRequestNotifications.textContent = '✅ Notifications Enabled';
          btnRequestNotifications.disabled = true;
          btnRequestNotifications.className = "bg-emerald-950/40 text-emerald-400 px-3 py-1.5 rounded-lg text-[10px] font-bold border border-emerald-500/20";
        }
        
        btnRequestNotifications.addEventListener('click', async () => {
          if (!('Notification' in window)) {
            alert('Notifications are not supported in this browser.');
            return;
          }
          const permission = await Notification.requestPermission();
          if (permission === 'granted') {
            btnRequestNotifications.textContent = '✅ Notifications Enabled';
            btnRequestNotifications.disabled = true;
            btnRequestNotifications.className = "bg-emerald-950/40 text-emerald-400 px-3 py-1.5 rounded-lg text-[10px] font-bold border border-emerald-500/20";
            window.scheduleReviewsCheck();
          } else if (permission === 'denied') {
            alert('Notification permission denied. Please reset permissions in your browser address bar.');
          }
        });
      }

      loadSections();
    });
  </script>
  <!-- Custom Confirmation Modal -->
  <div id="clear-confirm-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm transition duration-300">
    <div class="glass-card max-w-sm w-full rounded-2xl border border-stone-850 p-6 space-y-6 text-center shadow-2xl transform scale-95 opacity-0 transition duration-300">
      <div class="text-4xl">⚠️</div>
      <div class="space-y-2">
        <h3 class="text-lg font-bold text-white">Clear Study History?</h3>
        <p class="text-xs text-stone-400">Are you sure you want to clear your study progress history? This action is permanent and cannot be undone.</p>
      </div>
      <div class="flex gap-3">
        <button id="btn-clear-cancel" type="button" class="w-full bg-stone-900 border border-stone-800 text-stone-300 hover:text-white font-semibold py-2.5 px-4 rounded-lg text-xs transition active:scale-[0.98]">
          Cancel
        </button>
        <button id="btn-clear-confirm" type="button" class="w-full bg-gradient-to-r from-red-600 to-orange-600 hover:from-red-500 hover:to-orange-500 text-white font-bold py-2.5 px-4 rounded-lg text-xs shadow-lg active:scale-[0.98] transition">
          Clear History
        </button>
      </div>
    </div>
  </div>
</body>
</html>