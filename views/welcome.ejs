<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quizzard - Interactive AI Learning Platform</title>
  <script>
    if (localStorage.getItem('theme') === 'light') {
      document.documentElement.classList.add('theme-light');
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Light/Cream Theme overrides */
    .theme-light body {
      background: linear-gradient(135deg, #fdfbf7 0%, #f4efe6 50%, #e9e0d2 100%);
      color: #292524;
    }
    .theme-light .glass-card {
      background: rgba(253, 251, 247, 0.75);
      border-color: rgba(41, 37, 36, 0.08);
      box-shadow: 0 10px 30px -10px rgba(120, 110, 90, 0.2), 0 1px 3px rgba(120, 110, 90, 0.05);
    }
    .theme-light h1, .theme-light h2, .theme-light h3 {
      color: #1c1917;
    }
    .theme-light p, .theme-light label {
      color: #44403c;
    }
    .theme-light .text-stone-300 {
      color: #292524;
    }
    .theme-light .text-stone-400, .theme-light .text-stone-550, .theme-light .text-stone-500 {
      color: #57524d;
    }
    .theme-light .text-stone-100 {
      color: #1c1917;
    }
    .theme-light .neon-border {
      background-color: rgba(255, 255, 255, 0.6);
      border-color: rgba(41, 37, 36, 0.12);
    }
    .theme-light select, .theme-light input[type="text"], .theme-light textarea {
      color: #1c1917;
    }
    .theme-light select option {
      background-color: #fdfbf7;
      color: #1c1917;
    }
    .theme-light .tab-active {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(217, 119, 6, 0.08) 100%);
      border-color: rgba(245, 158, 11, 0.4);
      color: #b45309;
    }
    .theme-light #theme-toggle {
      background-color: rgba(253, 251, 247, 0.8);
      border-color: rgba(41, 37, 36, 0.1);
      color: #1c1917;
      box-shadow: 0 4px 12px rgba(120, 110, 90, 0.1);
    }
    .theme-light #theme-toggle:hover {
      background-color: rgba(253, 251, 247, 0.95);
    }

    body {
      font-family: 'Outfit', sans-serif;
    }
    .glass-card {
      background: rgba(28, 25, 23, 0.75); /* warm dark stone background */
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .neon-border:focus-within {
      border-color: rgba(245, 158, 11, 0.7);
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
    }
    .tab-active {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.15) 100%);
      border-color: rgba(245, 158, 11, 0.5);
      color: #fef3c7; /* warm amber-100 */
    }
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    .float-icon {
      animation: float 4s ease-in-out infinite;
    }
    /* Loading animation dots */
    .dot-pulse {
      animation: pulse 1.4s infinite ease-in-out both;
    }
    .dot-pulse:nth-child(1) { animation-delay: -0.32s; }
    .dot-pulse:nth-child(2) { animation-delay: -0.16s; }
    @keyframes pulse {
      0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
      40% { transform: scale(1); opacity: 1; }
    }
  </style>
</head>
<body class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  <!-- Decorative background warm gold glow blobs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-2xl w-full">
    <!-- Header/Logo Area -->
    <div class="text-center mb-8 relative">
      <div class="inline-block float-icon mb-2 text-5xl">📚</div>
      <h1 class="text-5xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-amber-200 via-yellow-400 to-orange-400">
        Quizzard
      </h1>
      <p class="text-stone-400 mt-2 font-light tracking-wide text-sm sm:text-base">
        Interactive study engine powered by local storage & Gemini AI
      </p>
      
      <!-- Streak Badge -->
      <div id="streak-badge-container" class="mt-4 flex justify-center items-center hidden">
        <span class="inline-flex items-center gap-1.5 bg-orange-500/10 border border-orange-500/30 text-orange-400 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
          🔥 <span id="streak-count">0</span> Day Study Streak
        </span>
      </div>
    </div>

    <!-- Main Card -->
    <div class="glass-card rounded-2xl shadow-2xl p-6 sm:p-8 relative overflow-hidden transition-all duration-500">
      
      <!-- General Username Section -->
      <div class="mb-6">
        <label for="user-name" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">ENTER YOUR NAME</label>
        <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
          <span class="inline-flex items-center px-3 text-stone-600 text-lg">👤</span>
          <input type="text" id="user-name" class="block w-full p-3 bg-transparent text-stone-100 placeholder-stone-600 focus:outline-none text-base" placeholder="What should we call you?" required>
        </div>
      </div>

      <!-- Tab Navigation -->
      <div class="flex border-b border-stone-800 mb-6 gap-2">
        <button type="button" id="tab-standard" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>📖</span> Standard Quizzes
        </button>
        <button type="button" id="tab-ai" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>✨</span> AI Study Buddy <span class="bg-amber-500/20 text-amber-300 text-[10px] px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">New</span>
        </button>
        <button type="button" id="tab-history" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>📜</span> History
        </button>
      </div>

      <!-- Standard Form -->
      <form id="standard-form" class="space-y-6">
        <div>
          <label for="section-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">SELECT TOPIC</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">🏷️</span>
            <select id="section-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
              <option value="" disabled selected class="bg-stone-950 text-stone-400">Select a section</option>
            </select>
          </div>
          <div class="flex justify-between items-center mt-2 px-1">
            <span class="text-[10px] text-stone-500">Race against the clock to rank!</span>
            <button type="button" id="btn-view-leaderboard" class="text-xs text-amber-400 hover:text-amber-300 font-semibold flex items-center gap-1 transition">
              🏆 View Leaderboard
            </button>
          </div>
        </div>

        <div>
          <label for="difficulty-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">DIFFICULTY LEVEL</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">⚡</span>
            <select id="difficulty-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
              <option value="" disabled selected class="bg-stone-950 text-stone-400">Select difficulty</option>
              <option value="easy" class="bg-stone-950 text-stone-100">Easy</option>
              <option value="medium" class="bg-stone-950 text-stone-100">Medium</option>
              <option value="hard" class="bg-stone-950 text-stone-100">Hard</option>
            </select>
          </div>
        </div>

        <!-- Mode Selection -->
        <div>
          <label class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">PLAY MODE</label>
          <div class="grid grid-cols-2 gap-3">
            <button type="button" id="mode-single" class="tab-active p-3 border border-stone-800 bg-stone-950/40 rounded-lg text-sm text-stone-300 hover:text-stone-200 transition font-medium flex items-center justify-center gap-2">
              <span>👤</span> Single Player
            </button>
            <button type="button" id="mode-multiplayer" class="p-3 border border-stone-800 bg-stone-950/40 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition font-medium flex items-center justify-center gap-2">
              <span>👥</span> Multiplayer
            </button>
          </div>
        </div>

        <!-- Timed Challenge Mode Checkbox -->
        <div id="challenge-mode-container" class="flex items-center gap-2 mt-4 px-1">
          <input type="checkbox" id="challenge-mode-toggle" class="w-4 h-4 rounded border-stone-800 bg-stone-950 text-amber-500 focus:ring-0 cursor-pointer">
          <label for="challenge-mode-toggle" class="text-xs font-semibold text-stone-300 cursor-pointer select-none">⚡ TIMED CHALLENGE MODE</label>
        </div>

        <!-- Multiplayer Lobby Panel (Hidden initially) -->
        <div id="multiplayer-lobby" class="hidden border border-stone-800 bg-stone-950/20 rounded-xl p-4 space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2 text-center sm:text-left border-b sm:border-b-0 sm:border-r border-stone-800 pb-4 sm:pb-0 sm:pr-4">
              <p class="text-[10px] font-semibold text-stone-400 tracking-wider">HOST A GAME</p>
              <button type="button" id="btn-host-room" class="w-full bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold py-2.5 px-4 rounded-lg shadow hover:from-amber-500 hover:to-orange-500 transition text-sm flex items-center justify-center gap-1">
                Create Room
              </button>
              <div id="host-code-display" class="hidden space-y-2 mt-2">
                <p class="text-[10px] text-stone-500">Share this code with your friend:</p>
                <div id="room-code-val" class="bg-stone-900 border border-stone-800 text-amber-300 font-mono font-bold text-xl py-2 px-4 rounded tracking-widest text-center select-all select-none">
                  ------
                </div>
                <p class="text-[10px] text-stone-500 animate-pulse">Waiting for opponent to join...</p>
              </div>
            </div>
            <div class="space-y-2">
              <p class="text-[10px] font-semibold text-stone-400 tracking-wider">JOIN A GAME</p>
              <div class="flex gap-2">
                <input type="text" id="join-code-input" class="w-full p-2.5 border border-stone-800 bg-stone-950/45 text-stone-100 placeholder-stone-600 rounded-lg text-sm text-center font-mono tracking-widest uppercase focus:outline-none" placeholder="ENTER CODE" maxlength="6">
                <button type="button" id="btn-join-room" class="bg-stone-800 border border-stone-750 text-stone-300 hover:text-white font-semibold py-2.5 px-4 rounded-lg transition text-sm flex items-center justify-center gap-1 flex-shrink-0">
                  Join
                </button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label for="num-questions-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">NUMBER OF QUESTIONS</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">📋</span>
            <select id="num-questions-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
              <option value="5" selected class="bg-stone-950 text-stone-100">5 Questions</option>
              <option value="10" class="bg-stone-950 text-stone-100">10 Questions</option>
              <option value="15" class="bg-stone-950 text-stone-100">15 Questions</option>
              <option value="20" class="bg-stone-950 text-stone-100">20 Questions</option>
            </select>
          </div>
        </div>

        <button type="submit" id="btn-start-quiz" class="w-full bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold p-4 rounded-lg shadow-lg hover:from-amber-500 hover:to-orange-500 hover:shadow-amber-500/10 active:scale-[0.99] transition duration-300 flex items-center justify-center gap-2 group">
          Start Quiz <span class="group-hover:translate-x-1 transition-transform">➡️</span>
        </button>
      </form>

      <!-- AI Form (Hidden initially) -->
      <form id="ai-form" class="hidden space-y-6">
        <div>
          <label class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">PASTE STUDY NOTES OR UPLOAD FILE</label>
          
          <!-- Drag and Drop Zone -->
          <div id="drop-zone" class="w-full p-6 border-2 border-dashed border-stone-800 rounded-lg bg-stone-950/30 hover:border-amber-500/50 hover:bg-amber-500/5 transition duration-300 flex flex-col items-center justify-center cursor-pointer text-center relative mb-4">
            <input type="file" id="ai-file" name="file" accept=".txt,.md,.pdf" class="hidden">
            <span class="text-3xl mb-2">📁</span>
            <p id="drop-zone-text" class="text-sm text-stone-400">Drag & drop a file here, or <span class="text-amber-400 font-semibold underline">browse</span></p>
            <p class="text-xs text-stone-500 mt-1">Supports PDF, TXT, or Markdown (Max 5MB)</p>
          </div>

          <!-- File preview container -->
          <div id="file-preview" class="hidden mb-4 p-3 border border-stone-800 bg-stone-900/20 rounded-lg flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-xl">📄</span>
              <div class="text-left">
                <p id="file-name" class="text-xs font-semibold text-stone-200 truncate max-w-[200px]"></p>
                <p id="file-size" class="text-[10px] text-stone-500"></p>
              </div>
            </div>
            <button type="button" id="btn-remove-file" class="text-stone-500 hover:text-red-400 text-xs font-bold px-2 py-1 hover:bg-stone-850 rounded transition">
              Remove
            </button>
          </div>

          <div id="notes-textarea-container" class="space-y-2">
            <label for="ai-notes" class="block text-xs font-semibold text-stone-400 mb-1 tracking-wide flex justify-between">
              <span>OR PASTE TEXT DIRECTLY</span>
              <span id="char-count" class="text-[10px] font-normal text-stone-550">0 characters (min 50)</span>
            </label>
            <textarea id="ai-notes" rows="4" class="neon-border block w-full p-4 border border-stone-800 bg-stone-950/45 text-stone-100 rounded-lg placeholder-stone-600 focus:outline-none text-xs resize-none" placeholder="Paste study notes here (minimum 50 characters)..." required></textarea>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="ai-difficulty-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">TARGET DIFFICULTY</label>
            <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
              <span class="inline-flex items-center px-3 text-stone-600 text-lg">⚡</span>
              <select id="ai-difficulty-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
                <option value="easy" class="bg-stone-950 text-stone-100">Easy</option>
                <option value="medium" selected class="bg-stone-950 text-stone-100">Medium</option>
                <option value="hard" class="bg-stone-950 text-stone-100">Hard</option>
              </select>
            </div>
          </div>

          <div>
            <label for="ai-num-questions" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">NUMBER OF QUESTIONS</label>
            <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
              <span class="inline-flex items-center px-3 text-stone-600 text-lg">📋</span>
              <select id="ai-num-questions" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
                <option value="3" class="bg-stone-950 text-stone-100">3 Questions</option>
                <option value="5" selected class="bg-stone-950 text-stone-100">5 Questions</option>
                <option value="7" class="bg-stone-950 text-stone-100">7 Questions</option>
                <option value="10" class="bg-stone-950 text-stone-100">10 Questions</option>
              </select>
            </div>
          </div>
        </div>

        <button type="submit" class="w-full bg-gradient-to-r from-amber-500 via-orange-500 to-yellow-600 text-white font-semibold p-4 rounded-lg shadow-lg hover:from-amber-400 hover:via-orange-400 hover:to-yellow-500 hover:shadow-orange-500/10 active:scale-[0.99] transition duration-300 flex items-center justify-center gap-2 group">
          ✨ Generate Quiz with AI <span class="group-hover:scale-110 transition-transform">🔮</span>
        </button>
      </form>

      <!-- Loading / Progress State -->
      <div id="ai-loading" class="hidden flex-col items-center justify-center py-12 space-y-4">
        <div class="flex items-center gap-1.5 text-2xl">
          <span class="dot-pulse w-3 h-3 rounded-full bg-amber-400"></span>
          <span class="dot-pulse w-3 h-3 rounded-full bg-orange-400"></span>
          <span class="dot-pulse w-3 h-3 rounded-full bg-yellow-400"></span>
        </div>
        <p id="loading-status" class="text-amber-300 font-medium tracking-wide text-sm animate-pulse">Generating your custom quiz...</p>
        <p class="text-xs text-stone-500 text-center max-w-xs">This takes a few seconds as Gemini structures the concepts and correct choices.</p>
      </div>

      <!-- Error message container -->
      <div id="error-container" class="hidden mt-4 p-4 rounded-lg border border-red-500/30 bg-red-950/20 text-red-400 text-sm flex items-start gap-2.5">
        <span>⚠️</span>
        <div class="flex-1">
          <p id="error-message" class="font-medium"></p>
          <p id="error-help" class="text-xs text-stone-400 mt-1"></p>
        </div>
      </div>

      <!-- History Panel (Hidden initially) -->
      <div id="history-panel" class="hidden space-y-6">
        <div class="flex justify-between items-center mb-2">
          <h3 class="text-sm font-semibold text-stone-300 tracking-wide">PAST ATTEMPTS</h3>
          <button id="btn-clear-history" type="button" class="text-xs text-red-400 hover:text-red-300 hover:underline transition">
            Clear History
          </button>
        </div>
        <div id="history-list" class="space-y-3 max-h-[300px] overflow-y-auto pr-1">
          <!-- History items will be populated here -->
        </div>
      </div>

    </div>
  </div>

  <script>
    // Elements
    const tabStandard = document.getElementById('tab-standard');
    const tabAI = document.getElementById('tab-ai');
    const tabHistory = document.getElementById('tab-history');
    const standardForm = document.getElementById('standard-form');
    const aiForm = document.getElementById('ai-form');
    const historyPanel = document.getElementById('history-panel');
    const historyList = document.getElementById('history-list');
    const btnClearHistory = document.getElementById('btn-clear-history');
    const userNameInput = document.getElementById('user-name');
    const aiNotes = document.getElementById('ai-notes');
    const charCount = document.getElementById('char-count');
    const aiLoading = document.getElementById('ai-loading');
    const loadingStatus = document.getElementById('loading-status');
    const errorContainer = document.getElementById('error-container');
    const errorMessage = document.getElementById('error-message');
    const errorHelp = document.getElementById('error-help');

    // Status Texts to rotate
    const statusPhrases = [
      "Connecting to Gemini API...",
      "Analyzing study notes...",
      "Extracting key concepts...",
      "Drafting multiple-choice questions...",
      "Structuring correct options...",
      "Generating technical explanations...",
      "Saving database models..."
    ];
    let statusInterval;

    // Tabs logic
    tabStandard.addEventListener('click', () => {
      tabStandard.classList.add('tab-active', 'border-amber-500');
      tabAI.classList.remove('tab-active', 'border-amber-500');
      tabHistory.classList.remove('tab-active', 'border-amber-500');
      standardForm.classList.remove('hidden');
      aiForm.classList.add('hidden');
      historyPanel.classList.add('hidden');
      errorContainer.classList.add('hidden');
    });

    tabAI.addEventListener('click', () => {
      tabAI.classList.add('tab-active', 'border-amber-500');
      tabStandard.classList.remove('tab-active', 'border-amber-500');
      tabHistory.classList.remove('tab-active', 'border-amber-500');
      aiForm.classList.remove('hidden');
      standardForm.classList.add('hidden');
      historyPanel.classList.add('hidden');
      errorContainer.classList.add('hidden');
    });

    tabHistory.addEventListener('click', () => {
      tabHistory.classList.add('tab-active', 'border-amber-500');
      tabStandard.classList.remove('tab-active', 'border-amber-500');
      tabAI.classList.remove('tab-active', 'border-amber-500');
      historyPanel.classList.remove('hidden');
      standardForm.classList.add('hidden');
      aiForm.classList.add('hidden');
      errorContainer.classList.add('hidden');
      renderHistory();
    });

    function renderHistory() {
      const history = JSON.parse(localStorage.getItem('quizHistory') || '[]');
      if (history.length === 0) {
        historyList.innerHTML = `<p class="text-stone-500 text-sm text-center py-6">No previous attempts found. Take a quiz to start building history!</p>`;
        return;
      }

      historyList.innerHTML = '';
      history.forEach(item => {
        const historyCard = document.createElement('div');
        historyCard.className = "flex justify-between items-center p-3.5 border border-stone-800 bg-stone-900/20 rounded-lg hover:border-stone-750 transition";
        const percent = item.total > 0 ? Math.round((item.score / item.total) * 100) : 0;
        
        let scoreColor = "text-red-400";
        if (percent >= 80) scoreColor = "text-emerald-400";
        else if (percent >= 50) scoreColor = "text-amber-400";

        historyCard.innerHTML = `
          <div class="text-left space-y-0.5">
            <h4 class="text-sm font-semibold text-stone-200">${item.topic}</h4>
            <p class="text-[10px] text-stone-500">${item.date}</p>
          </div>
          <div class="text-right">
            <p class="text-sm font-bold ${scoreColor}">${item.score}/${item.total}</p>
            <p class="text-[10px] text-stone-500">${percent}% accuracy</p>
          </div>
        `;
        historyList.appendChild(historyCard);
      });
    }

    if (btnClearHistory) {
      btnClearHistory.addEventListener('click', () => {
        if (confirm("Are you sure you want to clear your quiz history?")) {
          localStorage.removeItem('quizHistory');
          renderHistory();
        }
      });
    }

    // Char counter
    aiNotes.addEventListener('input', () => {
      const len = aiNotes.value.length;
      charCount.textContent = `${len} characters (min 50)`;
      if (len >= 50) {
        charCount.classList.remove('text-stone-500');
        charCount.classList.add('text-amber-400');
      } else {
        charCount.classList.remove('text-amber-400');
        charCount.classList.add('text-stone-500');
      }
    });

    // Populate drop down with sections
    async function loadSections() {
      try {
        const response = await fetch('/api/quiz/sections');
        const sections = await response.json();
        const sectionSelect = document.getElementById('section-select');
        sections.forEach(section => {
          const option = document.createElement('option');
          option.value = section.id;
          option.textContent = section.name;
          option.className = "bg-stone-900 text-stone-100";
          sectionSelect.appendChild(option);
        });

        const savedSectionId = window.localStorage.getItem('sectionId');
        if (savedSectionId) {
          sectionSelect.value = savedSectionId;
        }
      } catch (err) {
        console.error("Error loading sections:", err);
      }
    }

    // Submit standard quiz setup
    standardForm.addEventListener('submit', function(event) {
      event.preventDefault();
      const userName = userNameInput.value.trim();
      const sectionId = document.getElementById('section-select').value;
      const difficulty = document.getElementById('difficulty-select').value;
      const count = document.getElementById('num-questions-select').value;
      const challengeMode = document.getElementById('challenge-mode-toggle').checked;

      if (!userName) return;

      window.localStorage.setItem('userName', userName);
      window.localStorage.setItem('sectionId', sectionId);
      window.localStorage.setItem('difficulty', difficulty);
      window.localStorage.setItem('questionCount', count);
      window.localStorage.setItem('challengeMode', challengeMode ? 'true' : 'false');
      window.location.href = '/quiz';
    });

    // View Leaderboard click
    document.getElementById('btn-view-leaderboard').addEventListener('click', () => {
      const sectionId = document.getElementById('section-select').value;
      if (!sectionId) {
        alert('Please select a topic first.');
        return;
      }
      window.location.href = `/leaderboard/${sectionId}`;
    });

    // File Upload Drag and Drop implementation
    const dropZone = document.getElementById('drop-zone');
    const aiFile = document.getElementById('ai-file');
    const filePreview = document.getElementById('file-preview');
    const fileNameEl = document.getElementById('file-name');
    const fileSizeEl = document.getElementById('file-size');
    const btnRemoveFile = document.getElementById('btn-remove-file');
    const aiNotesTextarea = document.getElementById('ai-notes');
    
    let selectedFile = null;

    dropZone.addEventListener('click', () => {
      aiFile.click();
    });

    aiFile.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleFile(e.target.files[0]);
      }
    });

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, (e) => {
        e.preventDefault();
        e.stopPropagation();
      }, false);
    });

    ['dragenter', 'dragover'].forEach(eventName => {
      dropZone.addEventListener(eventName, () => {
        dropZone.classList.add('border-amber-500/70', 'bg-amber-500/10');
      }, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
      dropZone.addEventListener(eventName, () => {
        dropZone.classList.remove('border-amber-500/70', 'bg-amber-500/10');
      }, false);
    });

    dropZone.addEventListener('drop', (e) => {
      const dt = e.dataTransfer;
      const files = dt.files;
      if (files.length > 0) {
        handleFile(files[0]);
      }
    });

    function handleFile(file) {
      const allowedExtensions = /(\.txt|\.md|\.pdf)$/i;
      if (!allowedExtensions.exec(file.name)) {
        alert('Invalid file type! Please upload a PDF, TXT, or Markdown (.md) file.');
        return;
      }

      if (file.size > 5 * 1024 * 1024) {
        alert('File is too large! Maximum allowed size is 5MB.');
        return;
      }

      selectedFile = file;
      fileNameEl.textContent = file.name;
      fileSizeEl.textContent = formatBytes(file.size);

      filePreview.classList.remove('hidden');
      aiNotesTextarea.value = '';
      aiNotesTextarea.removeAttribute('required');
      charCount.textContent = '0 characters (min 50)';
      charCount.className = 'text-[10px] font-normal text-stone-550';
    }

    btnRemoveFile.addEventListener('click', () => {
      selectedFile = null;
      aiFile.value = '';
      filePreview.classList.add('hidden');
      aiNotesTextarea.setAttribute('required', '');
    });

    function formatBytes(bytes, decimals = 2) {
      if (bytes === 0) return '0 Bytes';
      const k = 1024;
      const dm = decimals < 0 ? 0 : decimals;
      const sizes = ['Bytes', 'KB', 'MB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
    }

    // Submit AI quiz generator
    aiForm.addEventListener('submit', async function(event) {
      event.preventDefault();
      errorContainer.classList.add('hidden');
      const userName = userNameInput.value.trim();
      const text = aiNotes.value;
      const difficulty = document.getElementById('ai-difficulty-select').value;
      const numQuestions = document.getElementById('ai-num-questions').value;

      if (!userName) {
        userNameInput.focus();
        userNameInput.reportValidity();
        return;
      }

      if (!selectedFile && text.trim().length < 50) {
        alert("Please enter at least 50 characters of study notes or upload a file.");
        return;
      }

      // Show loading state, hide form buttons
      aiForm.classList.add('hidden');
      aiLoading.classList.remove('hidden');
      userNameInput.disabled = true;

      // Start status rotating text
      let phraseIdx = 0;
      loadingStatus.textContent = statusPhrases[0];
      statusInterval = setInterval(() => {
        phraseIdx = (phraseIdx + 1) % statusPhrases.length;
        loadingStatus.textContent = statusPhrases[phraseIdx];
      }, 1800);

      // Create FormData to send file and metadata
      const formData = new FormData();
      if (selectedFile) {
        formData.append('file', selectedFile);
      } else {
        formData.append('text', text);
      }
      formData.append('difficulty', difficulty);
      formData.append('userName', userName);
      formData.append('numQuestions', numQuestions);

      try {
        const response = await fetch('/api/quiz/generate-ai', {
          method: 'POST',
          body: formData
        });

        const data = await response.json();

        if (!response.ok) {
          throw { 
            message: data.error || 'Server error occurred during generation', 
            isApiKeyError: data.error && data.error.includes('API key') 
          };
        }

        // Save metadata and redirect
        window.localStorage.setItem('userName', userName);
        window.localStorage.setItem('sectionId', data.sectionId);
        window.localStorage.setItem('difficulty', difficulty);
        
        clearInterval(statusInterval);
        window.location.href = '/quiz';

      } catch (err) {
        clearInterval(statusInterval);
        aiLoading.classList.add('hidden');
        aiForm.classList.remove('hidden');
        userNameInput.disabled = false;

        errorContainer.classList.remove('hidden');
        errorMessage.textContent = err.message || 'An unexpected error occurred.';
        
        if (err.isApiKeyError) {
          errorHelp.innerHTML = 'To fix this, create a <strong>.env</strong> file in your project root containing: <br><code class="block bg-stone-950 p-2 rounded text-amber-300 mt-1 select-all font-mono">GEMINI_API_KEY=your_api_key_here</code><br>You can acquire a free developer key from <a href="https://ai.google.dev/aistudio" target="_blank" class="underline text-amber-400 hover:text-amber-300">Google AI Studio</a>.';
        } else {
          errorHelp.textContent = 'Check your internet connection or try shortening/modifying the input text.';
        }
      }
    });

    // Socket initialization
    let socket;
    function initSocket() {
      if (socket) return socket;
      socket = io();
      
      socket.on('roomCreated', ({ roomCode }) => {
        document.getElementById('room-code-val').textContent = roomCode;
        document.getElementById('host-code-display').classList.remove('hidden');
        document.getElementById('btn-host-room').disabled = true;
        document.getElementById('btn-host-room').textContent = 'Room Created';
      });

      socket.on('roomReady', ({ roomCode, sectionId, difficulty, count }) => {
        window.localStorage.setItem('roomCode', roomCode);
        window.localStorage.setItem('sectionId', sectionId);
        window.localStorage.setItem('difficulty', difficulty);
        window.localStorage.setItem('questionCount', count);
        window.localStorage.setItem('multiplayer', 'true');
        
        const userName = userNameInput.value.trim();
        window.localStorage.setItem('userName', userName);
        
        window.location.href = '/quiz';
      });

      socket.on('errorMessage', (msg) => {
        alert(msg);
      });

      return socket;
    }

    // Play Mode toggles
    const modeSingleBtn = document.getElementById('mode-single');
    const modeMultiplayerBtn = document.getElementById('mode-multiplayer');
    const multiplayerLobby = document.getElementById('multiplayer-lobby');
    const btnStartQuiz = document.getElementById('btn-start-quiz');

    if (modeSingleBtn && modeMultiplayerBtn && multiplayerLobby && btnStartQuiz) {
      modeSingleBtn.addEventListener('click', () => {
        modeSingleBtn.classList.add('tab-active', 'text-stone-300');
        modeSingleBtn.classList.remove('text-stone-400');
        modeMultiplayerBtn.classList.remove('tab-active', 'text-stone-300');
        modeMultiplayerBtn.classList.add('text-stone-400');
        multiplayerLobby.classList.add('hidden');
        btnStartQuiz.classList.remove('hidden');
      });

      modeMultiplayerBtn.addEventListener('click', () => {
        modeMultiplayerBtn.classList.add('tab-active', 'text-stone-300');
        modeMultiplayerBtn.classList.remove('text-stone-400');
        modeSingleBtn.classList.remove('tab-active', 'text-stone-300');
        modeSingleBtn.classList.add('text-stone-400');
        multiplayerLobby.classList.remove('hidden');
        btnStartQuiz.classList.add('hidden');
      });
    }

    // Host room action
    const btnHostRoom = document.getElementById('btn-host-room');
    if (btnHostRoom) {
      btnHostRoom.addEventListener('click', () => {
        const userName = userNameInput.value.trim();
        if (!userName) {
          userNameInput.focus();
          userNameInput.reportValidity();
          return;
        }

        const sectionId = document.getElementById('section-select').value;
        const difficulty = document.getElementById('difficulty-select').value;
        const count = window.localStorage.getItem('questionCount') || '5';

        if (!sectionId || !difficulty) {
          alert('Please select a topic and difficulty first.');
          return;
        }

        const s = initSocket();
        s.emit('createRoom', { userName, sectionId, difficulty, count });
      });
    }

    // Join room action
    const btnJoinRoom = document.getElementById('btn-join-room');
    const joinCodeInput = document.getElementById('join-code-input');
    if (btnJoinRoom && joinCodeInput) {
      btnJoinRoom.addEventListener('click', () => {
        const userName = userNameInput.value.trim();
        if (!userName) {
          userNameInput.focus();
          userNameInput.reportValidity();
          return;
        }

        const roomCode = joinCodeInput.value.trim();
        if (roomCode.length !== 6 || isNaN(parseInt(roomCode, 10))) {
          alert('Please enter a valid 6-digit room code.');
          return;
        }

        const s = initSocket();
        s.emit('joinRoom', { roomCode, userName });
      });
    }

    function initThemeToggle() {
      const toggleBtn = document.createElement('button');
      toggleBtn.id = 'theme-toggle';
      toggleBtn.className = 'fixed top-4 right-4 bg-stone-900/80 hover:bg-stone-800 text-stone-200 p-3 rounded-full border border-stone-800 hover:border-stone-700 shadow-lg active:scale-95 transition z-50 text-xl w-12 h-12 flex items-center justify-center';
      toggleBtn.setAttribute('aria-label', 'Toggle theme');
      
      const isLight = document.documentElement.classList.contains('theme-light');
      toggleBtn.textContent = isLight ? '🌙' : '☀️';

      document.body.appendChild(toggleBtn);

      toggleBtn.addEventListener('click', () => {
        const currentlyLight = document.documentElement.classList.contains('theme-light');
        if (currentlyLight) {
          document.documentElement.classList.remove('theme-light');
          localStorage.setItem('theme', 'dark');
          toggleBtn.textContent = '☀️';
        } else {
          document.documentElement.classList.add('theme-light');
          localStorage.setItem('theme', 'light');
          toggleBtn.textContent = '🌙';
        }
      });
    }

    // Init
    document.addEventListener('DOMContentLoaded', () => {
      // Initialize theme toggler
      initThemeToggle();

      // Streak validation
      const streakDataRaw = localStorage.getItem('streakData');
      const container = document.getElementById('streak-badge-container');
      const countEl = document.getElementById('streak-count');
      
      if (streakDataRaw) {
        try {
          const data = JSON.parse(streakDataRaw);
          if (data.lastDate) {
            const today = new Date();
            today.setHours(0,0,0,0);
            const last = new Date(data.lastDate);
            last.setHours(0,0,0,0);
            
            const diffTime = Math.abs(today - last);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            
            if (diffDays > 1) {
              data.streak = 0;
              data.lastDate = null;
              localStorage.setItem('streakData', JSON.stringify(data));
            }
          }
          if (data.streak > 0) {
            countEl.textContent = data.streak;
            container.classList.remove('hidden');
          } else {
            container.classList.add('hidden');
          }
        } catch (e) {
          console.error("Error loading streak data", e);
        }
      }

      // Default Active Tab styling
      tabStandard.classList.add('tab-active', 'border-amber-500');

      const savedUserName = window.localStorage.getItem('userName');
      if (savedUserName) {
        userNameInput.value = savedUserName;
      }

      const savedDifficulty = window.localStorage.getItem('difficulty');
      if (savedDifficulty) {
        document.getElementById('difficulty-select').value = savedDifficulty;
      }

      loadSections();
    });
  </script>
</body>
</html>