            <input type="file" id="import-progress-file" accept=".txt" class="hidden">
            <button id="btn-import-history" type="button" class="text-xs text-amber-400 hover:text-amber-300 hover:underline transition">
              📥 Import Progress
            </button>
            <button id="btn-clear-history" type="button" class="text-xs text-red-400 hover:text-red-300 hover:underline transition">
              Clear History
            </button>
