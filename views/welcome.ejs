        <div class="flex justify-between items-center mb-2">
          <h3 class="text-sm font-semibold text-stone-300 tracking-wide">PAST ATTEMPTS</h3>
          <div class="flex items-center gap-4">
            <button id="btn-export-history" type="button" class="text-xs text-amber-400 hover:text-amber-300 hover:underline transition">
