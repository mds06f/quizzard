<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quizzard - Interactive AI Learning Platform</title>
  <script>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches)) {
      document.documentElement.classList.add('theme-light');
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="manifest" href="/manifest.json">
  <script src="/js/offlineSync.js"></script>
  <meta name="theme-color" content="#0c0a09">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    /* Light/Cream Theme overrides */
    .theme-light body {
      background: linear-gradient(135deg, #fdfbf7 0%, #f4efe6 50%, #e9e0d2 100%);
      color: #292524;
    }
    .theme-light .glass-card {
      background: rgba(253, 251, 247, 0.75);
      border-color: rgba(41, 37, 36, 0.08);
      box-shadow: 0 10px 30px -10px rgba(120, 110, 90, 0.2), 0 1px 3px rgba(120, 110, 90, 0.05);
    }
    .theme-light h1, .theme-light h2, .theme-light h3 {
      color: #1c1917;
    }
    .theme-light p, .theme-light label {
      color: #44403c;
    }
    .theme-light .text-stone-300 {
      color: #292524;
    }
    .theme-light .text-stone-400, .theme-light .text-stone-550, .theme-light .text-stone-500 {
      color: #57524d;
    }
    .theme-light .text-stone-100 {
      color: #1c1917;
    }
    .theme-light .neon-border {
      background-color: rgba(255, 255, 255, 0.6);
      border-color: rgba(41, 37, 36, 0.12);
    }
    .theme-light select, .theme-light input[type="text"], .theme-light textarea {
      color: #1c1917;
    }
    .theme-light select option {
      background-color: #fdfbf7;
      color: #1c1917;
    }
    .theme-light .tab-active {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.08) 0%, rgba(217, 119, 6, 0.08) 100%);
      border-color: rgba(245, 158, 11, 0.4);
      color: #b45309;
    }
    .theme-light #theme-toggle {
      background-color: rgba(253, 251, 247, 0.8);
      border-color: rgba(41, 37, 36, 0.1);
      color: #1c1917;
      box-shadow: 0 4px 12px rgba(120, 110, 90, 0.1);
    }
    .theme-light #theme-toggle:hover {
      background-color: rgba(253, 251, 247, 0.95);
    }

    body {
      font-family: 'Outfit', sans-serif;
    }
    .glass-card {
      background: rgba(28, 25, 23, 0.75); /* warm dark stone background */
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
    .neon-border:focus-within {
      border-color: rgba(245, 158, 11, 0.7);
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.2);
    }
    .tab-active {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.15) 100%);
      border-color: rgba(245, 158, 11, 0.5);
      color: #fef3c7; /* warm amber-100 */
    }
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
    }
    .float-icon {
      animation: float 4s ease-in-out infinite;
    }
    /* Loading animation dots */
    .dot-pulse {
      animation: pulse 1.4s infinite ease-in-out both;
    }
    .dot-pulse:nth-child(1) { animation-delay: -0.32s; }
    .dot-pulse:nth-child(2) { animation-delay: -0.16s; }
    @keyframes pulse {
      0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
      40% { transform: scale(1); opacity: 1; }
    }
    /* Smooth theme transitions */
    body, .glass-card, h1, h2, h3, h4, p, span, label, button, input, select, textarea, .neon-border {
      transition: background-color 300ms ease, border-color 300ms ease, color 300ms ease, box-shadow 300ms ease;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  <!-- Decorative background warm gold glow blobs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-2xl w-full">
    <!-- Header/Logo Area -->
    <div class="text-center mb-8 relative">
      <div class="inline-block float-icon mb-2 text-5xl">📚</div>
      <h1 class="text-5xl font-extrabold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-amber-200 via-yellow-400 to-orange-400">
        Quizzard
      </h1>
      <p class="text-stone-400 mt-2 font-light tracking-wide text-sm sm:text-base">
        Interactive study engine powered by local storage & Gemini AI
      </p>
      
      <!-- Offline & Sync Status Banner -->
      <div id="offline-status-container" class="mt-4 flex flex-wrap justify-center gap-2">
        <span id="offline-badge" class="inline-flex items-center gap-1.5 bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm hidden">
          🔴 Offline Mode
        </span>
        <span id="sync-badge" class="inline-flex items-center gap-1.5 bg-blue-500/10 border border-blue-500/30 text-blue-400 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm hidden">
          🔄 <span id="sync-count">0</span> Pending Syncs
        </span>
      </div>

      <!-- Streak Badge -->
      <div id="streak-badge-container" class="mt-4 flex justify-center items-center hidden">
        <span class="inline-flex items-center gap-1.5 bg-orange-500/10 border border-orange-500/30 text-orange-400 text-xs font-bold px-3 py-1.5 rounded-full shadow-sm">
          🔥 <span id="streak-count">0</span> Day Study Streak
        </span>
      </div>
    </div>

    <!-- Main Card -->
    <div class="glass-card rounded-2xl shadow-2xl p-6 sm:p-8 relative overflow-hidden transition-all duration-500">
      
      <!-- General Username Section -->
      <div class="mb-6">
        <label for="user-name" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">ENTER YOUR NAME</label>
        <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
          <span class="inline-flex items-center px-3 text-stone-600 text-lg">👤</span>
          <input type="text" id="user-name" class="block w-full p-3 bg-transparent text-stone-100 placeholder-stone-600 focus:outline-none text-base" placeholder="What should we call you?" required minlength="3" maxlength="15" pattern="^[a-zA-Z0-9]{3,15}$" title="Username must be 3-15 alphanumeric characters (letters and numbers only).">
        </div>
      </div>

      <!-- Settings Panel -->
      <div class="mb-6 p-4 bg-stone-900/40 border border-stone-850 rounded-xl space-y-4">
        <h3 class="text-xs font-bold text-stone-400 tracking-wider uppercase">User Settings</h3>
        <div class="flex flex-col sm:flex-row gap-6">
          <label class="flex items-center gap-2.5 text-xs font-semibold text-stone-300 cursor-pointer select-none">
            <input type="checkbox" id="settings-sound" class="w-4 h-4 rounded border-stone-800 bg-stone-950 text-amber-500 focus:ring-0 cursor-pointer">
            <span>🔊 Enable Sound Effects</span>
          </label>
          <label class="flex items-center gap-2.5 text-xs font-semibold text-stone-300 cursor-pointer select-none">
            <input type="checkbox" id="settings-vibration" class="w-4 h-4 rounded border-stone-800 bg-stone-950 text-amber-500 focus:ring-0 cursor-pointer">
            <span>📳 Enable Haptic Vibration</span>
          </label>
        </div>
        
        <div>
          <label for="settings-waveform" class="block text-[10px] font-semibold text-stone-400 mb-1.5 uppercase">Sound Waveform Type</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-sm">🎵</span>
            <select id="settings-waveform" class="block w-full p-2 bg-transparent text-stone-300 focus:outline-none text-xs cursor-pointer">
              <option value="sine" class="bg-stone-950 text-stone-100">Sine Wave (Default)</option>
              <option value="triangle" class="bg-stone-950 text-stone-100">Triangle Wave</option>
              <option value="sawtooth" class="bg-stone-950 text-stone-100">Sawtooth Wave</option>
              <option value="square" class="bg-stone-950 text-stone-100">Square Wave</option>
            </select>
          </div>
        </div>

        <div>
          <label for="settings-volume" class="block text-[10px] font-semibold text-stone-400 mb-1.5 uppercase">Sound Volume</label>
          <div class="flex items-center gap-3">
            <span class="text-stone-600 text-sm">🔈</span>
            <input type="range" id="settings-volume" min="0" max="100" class="w-full h-1 bg-stone-800 rounded-lg appearance-none cursor-pointer accent-amber-500">
            <span class="text-stone-600 text-sm">🔊</span>
            <span id="volume-value-label" class="text-[10px] text-stone-400 font-bold w-8 text-right">100%</span>
          </div>
        </div>
      </div>

      <!-- PWA Install Banner (Hidden by default) -->
      <div id="pwa-install-banner" class="hidden mb-6 p-4 bg-amber-500/10 border border-amber-500/25 rounded-2xl flex flex-col sm:flex-row justify-between items-center gap-4 shadow-lg shadow-amber-500/5">
        <div class="flex items-center gap-3">
          <span class="text-2xl">📲</span>
          <div class="text-left">
            <h3 class="text-sm font-bold text-white">Install Quizzard App</h3>
            <p class="text-[10px] text-stone-400">Access your study buddy offline anytime from your home screen</p>
          </div>
        </div>
        <div class="flex gap-2 w-full sm:w-auto">
          <button id="btn-pwa-dismiss" type="button" class="flex-1 sm:flex-none bg-stone-850 hover:bg-stone-800 text-stone-300 px-3 py-1.5 rounded-lg text-xs font-semibold border border-stone-750 transition">
            Dismiss
          </button>
          <button id="btn-pwa-install" type="button" class="flex-1 sm:flex-none bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white px-4 py-1.5 rounded-lg text-xs font-bold shadow transition">
            Install
          </button>
        </div>
      </div>

      <!-- Tab Navigation -->
      <div class="flex border-b border-stone-800 mb-6 gap-2">
        <button type="button" id="tab-standard" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>📖</span> Standard Quizzes
        </button>
        <button type="button" id="tab-ai" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>✨</span> AI Buddy
        </button>
        <button type="button" id="tab-spaced" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>🧠</span> Review <span id="spaced-badge" class="hidden bg-amber-500 text-stone-950 text-[9px] px-1.5 py-0.5 rounded-full font-extrabold">0</span>
        </button>
        <button type="button" id="tab-history" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>📜</span> History
        </button>
        <button type="button" id="tab-analytics" class="flex-1 pb-3 text-sm font-medium border-b-2 border-transparent text-stone-400 hover:text-stone-200 transition duration-300 flex items-center justify-center gap-2">
          <span>📊</span> Analytics
        </button>
      </div>

      <!-- Standard Form -->
      <form id="standard-form" class="space-y-6">
        <div>
          <label for="section-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">SELECT TOPIC</label>
          <!-- Category Filter Pills -->
          <div id="category-filter-pills" class="flex flex-wrap gap-2 mb-3"></div>

          <!-- Topic Search Bar -->
          <div class="neon-border relative flex items-center rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300 mb-3">
            <span class="inline-flex items-center px-3 text-stone-600 text-sm">🔍</span>
            <input type="text" id="topic-search" class="block w-full py-2.5 pl-0 pr-8 bg-transparent text-stone-100 placeholder-stone-600 focus:outline-none text-xs" placeholder="Search topics...">
            <button type="button" id="btn-clear-search" class="hidden absolute right-2.5 text-stone-500 hover:text-stone-300 font-bold text-sm transition focus:outline-none select-none">
              &times;
            </button>
          </div>

          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">🏷️</span>
            <select id="section-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
              <option value="" disabled selected class="bg-stone-950 text-stone-400">Select a section</option>
            </select>
          </div>
          <div class="flex justify-between items-center mt-2 px-1">
            <span class="text-[10px] text-stone-500">Race against the clock to rank!</span>
            <button type="button" id="btn-view-leaderboard" class="text-xs text-amber-400 hover:text-amber-300 font-semibold flex items-center gap-1 transition">
              🏆 View Leaderboard
            </button>
          </div>
          
          <!-- Multi-Category Custom Quiz Mixer Toggle -->
          <div class="mt-3 p-3 bg-stone-900/40 border border-stone-800 rounded-xl space-y-2">
            <div class="flex items-center justify-between">
              <label for="custom-mix-toggle" class="text-xs font-bold text-stone-300 flex items-center gap-1.5 cursor-pointer">
                <span>🔀</span> Multi-Category Custom Quiz Mix
              </label>
              <input type="checkbox" id="custom-mix-toggle" class="w-4 h-4 rounded border-stone-800 bg-stone-950 text-amber-500 focus:ring-0 cursor-pointer">
            </div>
            <p class="text-[10px] text-stone-500">Enable to mix questions across multiple topics simultaneously.</p>
            <div id="custom-mix-category-list" class="hidden grid grid-cols-2 gap-2 pt-2 border-t border-stone-850 max-h-36 overflow-y-auto">
              <!-- Dynamically populated category checkboxes -->
            </div>
          </div>
          
          <!-- Topic Details Container -->
          <div id="topic-details-container" class="hidden mt-3 p-3 bg-stone-900/50 border border-stone-850 rounded-xl space-y-1">
            <div class="flex justify-between text-[11px] text-stone-400">
              <span>Overall Difficulty:</span>
              <span id="topic-detail-difficulty" class="font-semibold text-stone-300">-</span>
            </div>
            <div class="flex justify-between text-[11px] text-stone-400">
              <span>Total Questions:</span>
              <span id="topic-detail-questions" class="font-semibold text-stone-300">-</span>
            </div>
            <div class="flex justify-between text-[11px] text-stone-400">
              <span>Your Avg Accuracy:</span>
              <span id="topic-detail-accuracy" class="font-semibold text-amber-400">-</span>
            </div>
          </div>
        </div>

        <div>
          <label for="difficulty-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">DIFFICULTY LEVEL</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">⚡</span>
            <select id="difficulty-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
              <option value="" disabled selected class="bg-stone-950 text-stone-400">Select difficulty</option>
              <option value="easy" class="bg-stone-950 text-stone-100">Easy</option>
              <option value="medium" class="bg-stone-950 text-stone-100">Medium</option>
              <option value="hard" class="bg-stone-950 text-stone-100">Hard</option>
            </select>
          </div>
        </div>

        <!-- Special Gameplay Mode -->
        <div>
          <label for="special-mode-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">SPECIAL GAMEPLAY MODE</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">🎮</span>
            <select id="special-mode-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer">
              <option value="standard" class="bg-stone-950 text-stone-100" selected>Standard Multiple-Choice</option>
              <option value="sudden-death" class="bg-stone-950 text-stone-100">💀 Sudden Death (Instant Loss on Error)</option>
              <option value="flashcards" class="bg-stone-950 text-stone-100">🎴 Flashcard Practice (Flip & Self-Rate)</option>
            </select>
          </div>
          <div id="special-mode-desc-container" class="hidden mt-2.5 p-3 bg-amber-950/20 border border-amber-500/20 rounded-xl text-xs text-amber-200 animate-fade-in transition duration-300">
            <p id="special-mode-desc-text"></p>
          </div>
        </div>

        <!-- Timed Challenge Mode Checkbox -->
        <div id="challenge-mode-container" class="flex items-center gap-2 mt-4 px-1">
          <input type="checkbox" id="challenge-mode-toggle" class="w-4 h-4 rounded border-stone-800 bg-stone-950 text-amber-500 focus:ring-0 cursor-pointer">
          <label for="challenge-mode-toggle" class="text-xs font-semibold text-stone-300 cursor-pointer select-none">⚡ TIMED CHALLENGE MODE</label>
        </div>

        <!-- Multiplayer Lobby Panel (Hidden initially) -->
        <div id="multiplayer-lobby" class="hidden border border-stone-800 bg-stone-950/20 rounded-xl p-4 space-y-4">
          <!-- Room Mode Toggle -->
          <div class="flex items-center justify-between pb-3 border-b border-stone-850">
            <span class="text-xs font-bold text-stone-300 tracking-wide uppercase">Multiplayer Mode</span>
            <div class="flex bg-stone-900 border border-stone-800 rounded-lg p-0.5">
              <button type="button" id="btn-multi-mode-competitive" class="px-3 py-1 text-[10px] font-bold rounded bg-amber-600 text-white transition cursor-pointer" data-mode="competitive">1v1 Duel</button>
              <button type="button" id="btn-multi-mode-cooperative" class="px-3 py-1 text-[10px] font-bold rounded text-stone-400 hover:text-stone-200 transition cursor-pointer" data-mode="cooperative">Co-op Study</button>
            </div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-2 text-center sm:text-left border-b sm:border-b-0 sm:border-r border-stone-800 pb-4 sm:pb-0 sm:pr-4">
              <p class="text-[10px] font-semibold text-stone-400 tracking-wider">HOST A GAME</p>
              <button type="button" id="btn-host-room" class="w-full bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold py-2.5 px-4 rounded-lg shadow hover:from-amber-500 hover:to-orange-500 transition text-sm flex items-center justify-center gap-1">
                Create Room
              </button>
              <div id="host-code-display" class="hidden space-y-2 mt-2">
                <p class="text-[10px] text-stone-500">Share this code with your friend:</p>
                <div id="room-code-val" class="bg-stone-900 border border-stone-800 text-amber-300 font-mono font-bold text-xl py-2 px-4 rounded tracking-widest text-center select-all select-none">
                  ------
                </div>
                <p class="text-[10px] text-stone-500 animate-pulse">Waiting for opponent to join...</p>
              </div>
            </div>
            <div class="space-y-2">
              <p class="text-[10px] font-semibold text-stone-400 tracking-wider">JOIN A GAME</p>
              <div class="flex gap-2">
                <input type="text" id="join-code-input" class="w-full p-2.5 border border-stone-800 bg-stone-950/45 text-stone-100 placeholder-stone-600 rounded-lg text-sm text-center font-mono tracking-widest uppercase focus:outline-none" placeholder="ENTER CODE" maxlength="6">
                <button type="button" id="btn-join-room" class="bg-stone-800 border border-stone-750 text-stone-300 hover:text-white font-semibold py-2.5 px-4 rounded-lg transition text-sm flex items-center justify-center gap-1 flex-shrink-0">
                  Join
                </button>
              </div>
            </div>
          </div>
        </div>

        <div>
          <label for="num-questions-select" class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">NUMBER OF QUESTIONS</label>
          <div class="neon-border flex rounded-lg border border-stone-800 bg-stone-950/45 transition duration-300">
            <span class="inline-flex items-center px-3 text-stone-600 text-lg">📋</span>
            <select id="num-questions-select" class="block w-full p-3 bg-transparent text-stone-300 focus:outline-none text-base cursor-pointer" required>
              <option value="5" selected class="bg-stone-950 text-stone-100">5 Questions</option>
              <option value="10" class="bg-stone-950 text-stone-100">10 Questions</option>
              <option value="15" class="bg-stone-950 text-stone-100">15 Questions</option>
              <option value="20" class="bg-stone-950 text-stone-100">20 Questions</option>
            </select>
          </div>
          <div id="quiz-est-time" class="mt-2 text-xs font-medium text-amber-300/90 flex items-center gap-1.5 px-1">
            <span>⏱️ Est. Completion Time:</span>
            <span id="est-time-val" class="font-bold text-amber-400">~1 min</span>
          </div>
        </div>

        <button type="submit" id="btn-start-quiz" class="w-full bg-gradient-to-r from-amber-600 to-orange-600 text-white font-semibold p-4 rounded-lg shadow-lg hover:from-amber-500 hover:to-orange-500 hover:shadow-amber-500/10 active:scale-[0.99] transition duration-300 flex items-center justify-center gap-2 group">
          Start Quiz <span class="group-hover:translate-x-1 transition-transform">➡️</span>
        </button>
      </form>

      <!-- AI Form (Hidden initially) -->
      <form id="ai-form" class="hidden space-y-6">
        <div>
          <label class="block text-sm font-semibold text-stone-300 mb-2 tracking-wide">PASTE STUDY NOTES OR UPLOAD FILE</label>
          
          <!-- Drag and Drop Zone -->
          <div id="drop-zone" class="w-full p-6 border-2 border-dashed border-stone-800 rounded-lg bg-stone-950/30 hover:border-amber-500/50 hover:bg-amber-500/5 transition duration-300 flex flex-col items-center justify-center cursor-pointer text-center relative mb-4">
            <input type="file" id="ai-file" name="file" accept=".txt,.md,.pdf" class="hidden">
            <span class="text-3xl mb-2">📁</span>
            <p id="drop-zone-text" class="text-sm text-stone-400">Drag & drop a file here, or <span class="text-amber-400 font-semibold underline">browse</span></p>
            <p class="text-xs text-stone-500 mt-1">Supports PDF, TXT, or Markdown (Max 5MB)</p>
          </div>

          <!-- File preview container -->
          <div id="file-preview" class="hidden mb-4 p-3 border border-stone-800 bg-stone-900/20 rounded-lg flex items-center justify-between">
