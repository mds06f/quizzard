<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Spectator Mode - Quizzard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/socket.io/socket.io.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Outfit', sans-serif; }
    .glass-card {
      background: rgba(28, 25, 23, 0.75);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }
  </style>
</head>
<body class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4">
  <div class="max-w-3xl w-full space-y-6">
    <div class="flex justify-between items-center px-2">
      <div class="flex items-center gap-3">
        <span class="text-3xl">👀</span>
        <div>
          <h1 class="text-xl font-bold text-amber-400">Live Quiz Spectator View</h1>
          <p class="text-xs text-stone-400">Room Code: <span id="spectate-room-code" class="font-mono text-amber-300 font-bold"><%= roomCode %></span></p>
        </div>
      </div>
      <a href="/" class="text-xs bg-stone-850 border border-stone-750 px-3 py-1.5 rounded-lg text-stone-300 hover:text-white transition">Exit Spectator Mode</a>
    </div>

    <div id="spectator-card" class="glass-card rounded-2xl p-6 sm:p-8 space-y-6 shadow-2xl">
      <div class="flex justify-between items-center pb-4 border-b border-stone-800">
        <div>
          <span class="text-xs text-stone-500 uppercase tracking-wider font-bold">Room Mode</span>
          <p id="spectate-mode" class="text-sm font-semibold text-stone-200 uppercase">Competitive</p>
        </div>
        <div class="text-right">
          <span class="text-xs text-stone-500 uppercase tracking-wider font-bold">Live Status</span>
          <p id="spectate-status" class="text-sm font-semibold text-emerald-400 animate-pulse">Monitoring Match...</p>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-xs font-bold text-stone-400 uppercase tracking-wider">Live Scoreboard</h3>
        <div id="spectate-players" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 bg-stone-900/60 border border-stone-850 rounded-xl animate-pulse text-center">
            <p class="text-xs text-stone-500">Connecting to room live stream...</p>
          </div>
        </div>
      </div>
    </div>
    <footer class="mt-8 text-center text-xs text-stone-500 tracking-wide">
      <p>&copy; <%= new Date().getFullYear() %> Quizzard. All rights reserved.</p>
    </footer>
  </div>

  <script>
    const socket = io();
    const roomCode = '<%= roomCode %>';

    socket.emit('joinSpectator', { roomCode });

    socket.on('spectatorState', (data) => {
      document.getElementById('spectate-mode').textContent = data.mode || 'Standard';
      renderPlayers(data.players);
    });

    socket.on('spectatorUpdate', (data) => {
      renderPlayers(data.players);
    });

    socket.on('errorMessage', (msg) => {
      document.getElementById('spectate-status').textContent = msg;
      document.getElementById('spectate-status').className = 'text-sm font-semibold text-red-400';
    });

    function renderPlayers(players) {
      const container = document.getElementById('spectate-players');
      if (!players || players.length === 0) {
        container.innerHTML = '<p class="text-xs text-stone-500">No active players in room.</p>';
        return;
      }

      container.innerHTML = players.map(p => `
        <div class="p-4 bg-stone-900/60 border border-stone-850 rounded-xl space-y-2">
          <div class="flex justify-between items-center">
            <span class="font-bold text-stone-200 text-sm">${p.name}</span>
            <span class="text-xs font-extrabold bg-amber-500/10 text-amber-400 border border-amber-500/20 px-2 py-0.5 rounded-full">Score: ${p.score}</span>
          </div>
          <div class="w-full bg-stone-850 h-2 rounded-full overflow-hidden">
            <div class="bg-gradient-to-r from-amber-500 to-orange-500 h-full transition-all duration-300" style="width: ${Math.min(100, (p.score / 5) * 100)}%"></div>
          </div>
        </div>
      `).join('');
    }
  </script>
</body>
</html>
