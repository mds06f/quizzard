<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Session - Quizzard</title>
  <script>
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'light' || (!savedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches)) {
      document.documentElement.classList.add('theme-light');
    }
  </script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/speechEngine.js"></script>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#0c0a09">
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .then((reg) => console.log('Service Worker registered in quiz:', reg.scope))
          .catch((err) => console.error('Service Worker registration in quiz failed:', err));
      });
    }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    /* Light/Cream Theme overrides */
    .theme-light body {
      background: linear-gradient(135deg, #fdfbf7 0%, #f4efe6 50%, #e9e0d2 100%);
      color: #292524;
    }
    .theme-light .glass-card {
      background: rgba(253, 251, 247, 0.75);
      border-color: rgba(41, 37, 36, 0.08);
      box-shadow: 0 10px 30px -10px rgba(120, 110, 90, 0.2), 0 1px 3px rgba(120, 110, 90, 0.05);
    }
    .theme-light h1, .theme-light h2, .theme-light h3 {
      color: #1c1917;
    }
    .theme-light p, .theme-light label {
      color: #44403c;
    }
    .theme-light .text-stone-300 {
      color: #292524;
    }
    .theme-light .text-stone-400, .theme-light .text-stone-550, .theme-light .text-stone-500 {
      color: #57524d;
    }
    .theme-light .text-stone-100 {
      color: #1c1917;
    }
    .theme-light .neon-border {
      background-color: rgba(255, 255, 255, 0.6);
      border-color: rgba(41, 37, 36, 0.12);
    }
    .theme-light select, .theme-light input[type="text"], .theme-light textarea {
      color: #1c1917;
    }
    .theme-light select option {
      background-color: #fdfbf7;
      color: #1c1917;
    }
    .theme-light #theme-toggle {
      background-color: rgba(253, 251, 247, 0.8);
      border-color: rgba(41, 37, 36, 0.1);
      color: #1c1917;
      box-shadow: 0 4px 12px rgba(120, 110, 90, 0.1);
    }
    .theme-light #theme-toggle:hover {
      background-color: rgba(253, 251, 247, 0.95);
    }
    .theme-light .bg-stone-905\/60, .theme-light .bg-stone-900\/60 {
      background-color: rgba(255, 255, 255, 0.5);
      border-color: rgba(41, 37, 36, 0.10);
    }
    .theme-light .border-stone-850 {
      border-color: rgba(41, 37, 36, 0.10);
    }
    .theme-light #sound-toggle {
      border-color: rgba(41, 37, 36, 0.15);
      color: #1c1917;
    }
    .theme-light #sound-toggle:hover {
      border-color: rgba(217, 119, 6, 0.4);
    }

    body {
      font-family: 'Outfit', sans-serif;
    }

    .glass-card {
      background: rgba(28, 25, 23, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Style for checked options */
    .option-card input[type="radio"]:checked+.option-label {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.15) 100%);
      border-color: rgba(217, 119, 6, 0.6);
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.15);
      color: #fef3c7;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s ease-out forwards;
    }
    /* Smooth theme transitions */
    body, .glass-card, h1, h2, h3, h4, p, span, label, button, input, select, textarea, .neon-border {
      transition: background-color 300ms ease, border-color 300ms ease, color 300ms ease, box-shadow 300ms ease;
    }
  </style>
</head>

<body
  class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  <!-- Decorative background glow blobs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-3xl w-full">
    <!-- Header info -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4 px-2">
      <div class="flex items-center gap-3">
        <span class="text-3xl">📖</span>
        <div>
          <h2 class="text-xl font-bold ...">Quizzard Session</h2>
          <p class="text-xs text-stone-400">
            Welcome back,
            <span id="user-name-display" class="text-amber-300 font-semibold"></span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="bg-stone-900/60 border border-stone-850 rounded-lg px-4 py-2 text-right">
          <p class="text-xs text-stone-500 uppercase tracking-wider">Active Topic</p>
          <p id="section-name-display" class="text-sm font-semibold text-amber-300"></p>
        </div>

        <button id="sound-toggle" type="button"
          class="bg-stone-900/60 border border-stone-850 rounded-lg px-3 py-2 hover:border-amber-500/40 transition">
          🔊
        </button>

        <button id="btn-read-aloud" type="button"
          class="bg-stone-900/60 border border-stone-850 text-stone-400 hover:text-white rounded-lg px-3 py-2 hover:border-amber-500/40 transition flex items-center gap-1.5 text-xs font-bold" title="Read Aloud Narration">
          📢 <span id="narration-status-label" class="hidden sm:inline text-stone-500">Read Aloud</span>
        </button>
        
        <button id="voice-command-toggle" type="button"
          class="bg-stone-900/60 border border-stone-850 text-stone-400 hover:text-white rounded-lg px-3 py-2 hover:border-amber-500/40 transition flex items-center gap-1.5 text-xs font-bold" title="Voice Commands mode">
          🎙️ <span id="voice-status-label" class="hidden sm:inline text-stone-500">Off</span>
        </button>

        <button id="pause-quiz-btn" type="button" onclick="togglePauseQuiz()"
          class="bg-stone-900/60 border border-stone-850 text-stone-400 hover:text-white rounded-lg px-3 py-2 hover:border-amber-500/40 transition flex items-center gap-1.5 text-xs font-bold" title="Pause Quiz">
          ⏸️ <span class="hidden sm:inline">Pause</span>
        </button>
      </div>
    </div>

    <!-- Multiplayer Scoreboard Header (Hidden by default) -->
    <div id="multiplayer-scoreboard" class="hidden mb-6 flex justify-around items-center border border-amber-500/20 bg-amber-500/5 rounded-xl p-3 text-sm">
      <div class="text-center">
        <p id="p1-name" class="font-bold text-stone-300">Player 1</p>
        <p id="p1-score" class="text-lg font-extrabold text-amber-400">0</p>
      </div>
      <div class="text-stone-600 font-bold text-lg">VS</div>
      <div class="text-center">
        <p id="p2-name" class="font-bold text-stone-300">Player 2</p>
        <p id="p2-score" class="text-lg font-extrabold text-amber-400">0</p>
      </div>
    </div>

    <!-- Cooperative Progress Scorecard Header (Hidden by default) -->
    <div id="cooperative-scoreboard" class="hidden mb-6 flex flex-col gap-3 border border-emerald-500/20 bg-emerald-500/5 rounded-xl p-4 text-sm">
      <div class="flex justify-between items-center pb-2 border-b border-stone-850">
        <span class="font-bold text-stone-300">👥 Team Co-op Study Room</span>
        <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2.5 py-0.5 rounded-full border border-emerald-500/25">
          Accuracy: <span id="coop-accuracy-val">100%</span>
        </span>
      </div>
      <div id="coop-players-list" class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
        <!-- populated dynamically -->
      </div>
    </div>

    <div id="multiplayer-announcement" class="hidden mb-6 text-center text-xs font-semibold text-amber-400 bg-amber-950/20 border border-amber-500/20 rounded-lg py-2 animate-pulse"></div>

    <!-- Quiz Pause Modal Overlay -->
    <div id="pause-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
      <div class="glass-card rounded-2xl p-8 max-w-md w-full text-center space-y-5 border border-stone-800 shadow-2xl">
        <div class="text-5xl animate-bounce">⏸️</div>
        <h2 class="text-2xl font-extrabold text-stone-100">Quiz Paused</h2>
        <p class="text-xs text-stone-400">Take a break! Your timer is paused and your current progress is autosaved.</p>
        <button onclick="togglePauseQuiz()" type="button"
          class="w-full bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold py-3 px-6 rounded-lg shadow-lg active:scale-95 transition cursor-pointer">
          ▶️ Resume Quiz
        </button>
      </div>
    </div>

    <!-- Pre-submission Answer Review Modal Overlay -->
    <div id="pre-submit-modal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
      <div class="glass-card rounded-2xl p-6 sm:p-8 max-w-lg w-full text-center space-y-5 border border-stone-800 shadow-2xl">
        <h3 class="text-xl font-bold text-stone-100 flex items-center justify-center gap-2">
          <span>📋</span> Answer Review & Progress Grid
        </h3>
        <p class="text-xs text-stone-400">Click any question badge to jump directly back to that question card.</p>
        
        <div id="pre-submit-grid" class="grid grid-cols-4 sm:grid-cols-5 gap-2.5 max-h-60 overflow-y-auto p-3 border border-stone-800 rounded-xl bg-stone-950/40">
          <!-- Populated dynamically -->
        </div>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <button type="button" onclick="closePreSubmitModal()" class="w-full bg-stone-850 hover:bg-stone-800 text-stone-300 font-semibold py-3 px-4 rounded-lg border border-stone-750 transition text-xs cursor-pointer">
            ⬅️ Back to Quiz
          </button>
          <button type="button" onclick="confirmFinalSubmission()" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3 px-4 rounded-lg shadow-lg active:scale-95 transition text-xs cursor-pointer">
            Confirm & Submit 🎉
          </button>
        </div>
      </div>
    </div>

    <!-- Main quiz card -->
    <div class="glass-card rounded-2xl shadow-2xl p-6 sm:p-8">

      <!-- Loading state -->
      <div id="quiz-loading" class="flex flex-col items-center justify-center py-20 space-y-4">
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-amber-400"></div>
        <p class="text-stone-400 text-sm">Loading quiz questions...</p>
      </div>

      <!-- Quiz form -->
      <form id="quiz-form" class="hidden space-y-6">
        <!-- Timer Progress Bar -->
        <div id="timer-bar-container" class="space-y-2 mb-6">
          <div class="flex justify-between items-center text-xs text-stone-400">
            <span id="question-counter" class="font-medium text-stone-300">Question 1 of 5</span>
            <!-- HUD Streak Tracker -->
            <span id="hud-streak-container" class="hidden bg-orange-500/10 border border-orange-500/35 text-orange-400 text-[10px] font-bold px-2 py-0.5 rounded-full flex items-center gap-1 transition-all duration-150">
              🔥 Streak <span id="hud-streak-count">0</span>
            </span>
            <span id="timer-text" class="font-bold text-amber-400 flex items-center gap-1">
              ⏱️ <span id="timer-seconds">20</span>s
            </span>
          </div>
          <div class="h-1.5 w-full bg-stone-900 rounded-full overflow-hidden border border-stone-800">
            <div id="timer-progress" class="h-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-100" style="width: 100%;"></div>
          </div>
        </div>

        <!-- Visual Progress Bar Indicator -->
        <div id="quiz-progress-container" class="space-y-1.5 mb-6">
          <div class="flex justify-between items-center text-[10px] font-bold text-stone-500 uppercase tracking-wider">
            <span>Progress Indicator</span>
            <div class="flex items-center gap-3">
              <span id="est-time-remaining" class="text-amber-400 font-bold normal-case tracking-normal">Est. Time: ~0 mins</span>
              <span id="quiz-progress-text">0 / 0 Completed</span>
            </div>
          </div>
          <div class="h-1.5 w-full bg-stone-900 rounded-full overflow-hidden border border-stone-800">
            <div id="quiz-progress-bar" class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 transition-all duration-300" style="width: 0%;"></div>
          </div>
        </div>

        <div id="quiz-container" class="space-y-8"></div>

        <div id="quiz-actions" class="pt-4 border-t border-stone-850 flex flex-col sm:flex-row gap-4 justify-between items-center">
          <p id="action-helper-text" class="text-xs text-stone-500">Select an option to proceed.</p>
          <button id="action-btn" type="button" disabled
            class="w-full sm:w-auto bg-stone-800 text-stone-500 font-semibold px-8 py-3 rounded-lg border border-stone-750 cursor-not-allowed transition duration-300">
            Select an option
          </button>
        </div>
      </form>
      <footer class="mt-8 text-center text-xs text-stone-500 tracking-wide">
        <p>&copy; <%= new Date().getFullYear() %> Quizzard. All rights reserved.</p>
      </footer>
    </div>

    <script>
      let audioCtx;

      function playClickSound() {
        if (localStorage.getItem('soundEnabled') === 'false') {
          return;
        }
        const storedVolume = parseInt(localStorage.getItem('soundVolume') || '100', 10);
        if (storedVolume === 0) {
          return;
        }

        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        if (audioCtx.state === "suspended") {
          audioCtx.resume();
        }

        const oscillator = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        oscillator.type = localStorage.getItem('soundWaveform') || 'sine';
        oscillator.frequency.value = 700;

        gainNode.gain.value = 0.05 * (storedVolume / 100);

        oscillator.start();
        oscillator.stop(audioCtx.currentTime + 0.08);
      }
      function triggerHapticFeedback() {
        if (localStorage.getItem('vibrationEnabled') !== 'false' && navigator.vibrate) {
          navigator.vibrate(30);
        }
      }
      let TIME_LIMIT = 20;
      const activeDifficultySetting = window.localStorage.getItem('difficulty') || 'medium';
      if (activeDifficultySetting === 'easy') {
        TIME_LIMIT = 30;
      } else if (activeDifficultySetting === 'hard') {
        TIME_LIMIT = 12;
      } else {
        TIME_LIMIT = 20;
      }
      let timerInterval = null;
      let timeLeft = TIME_LIMIT;
      let currentSessionStreak = 0;
      let currentQuestionIndex = 0;
      let totalQuestions = 0;
      let questionsData = [];
      const answersSubmitted = {};
      let quizStartTime = null;

      async function loadSectionName(sectionId) {
        const response = await fetch(`/api/quiz/sections/${sectionId}`);
        const section = await response.json();
        document.getElementById('section-name-display').textContent = section.name;
      }

      function toggleBookmark(questionId) {
        let bookmarks = JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]');
        const index = bookmarks.findIndex(q => q.id === questionId);
        const question = questionsData.find(q => q.id === questionId);
        if (index > -1) {
          bookmarks.splice(index, 1);
        } else {
          if (question) {
            bookmarks.push(question);
          }
        }
        localStorage.setItem('bookmarkedQuestions', JSON.stringify(bookmarks));
        updateBookmarkUI(questionId);
      }

      function updateBookmarkUI(questionId) {
        const btn = document.querySelector(`.bookmark-btn[data-question-id="${questionId}"]`);
        if (!btn) return;
        let bookmarks = JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]');
        const isBookmarked = bookmarks.some(q => q.id === questionId);
        btn.innerHTML = isBookmarked ? '★' : '☆';
        btn.title = isBookmarked ? 'Remove bookmark' : 'Bookmark this question';
      }

      function copyQuestionToClipboard(question) {
        if (!question) return;
        const formattedOptions = [
          `A) ${question.option1}`,
          `B) ${question.option2}`,
          `C) ${question.option3}`,
          `D) ${question.option4}`
        ].join('\n');
        const textToCopy = `Q: ${question.question}\n${formattedOptions}`;
        navigator.clipboard.writeText(textToCopy).then(() => {
          const btns = document.querySelectorAll(`.copy-question-btn[data-question-id="${question.id}"]`);
          btns.forEach(btn => {
            const originalHTML = btn.innerHTML;
            btn.innerHTML = '✅';
            setTimeout(() => { btn.innerHTML = originalHTML; }, 1500);
          });
        }).catch(err => {
          console.error('Failed to copy question text:', err);
        });
      }

      function updateTimerUI() {
        const progressPercent = (timeLeft / TIME_LIMIT) * 100;
        const progressEl = document.getElementById('timer-progress');
        const secondsEl = document.getElementById('timer-seconds');
        
        if (progressEl) {
          progressEl.style.width = `${progressPercent}%`;
          if (timeLeft < 5) {
            progressEl.className = 'h-full bg-red-500 transition-all duration-100';
          } else {
            progressEl.className = 'h-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-100';
          }
        }
        if (secondsEl) {
          secondsEl.textContent = Math.ceil(timeLeft);
        }
      }

      function startQuestion(index) {
        currentQuestionIndex = index;
        
        // Update visual progress bar indicator
        const progressPercent = totalQuestions > 0 ? ((index) / totalQuestions) * 100 : 0;
        const progressBar = document.getElementById('quiz-progress-bar');
        const progressText = document.getElementById('quiz-progress-text');
        if (progressBar) {
          progressBar.style.width = `${progressPercent}%`;
        }
        if (progressText) {
          progressText.textContent = `${index} / ${totalQuestions} Completed`;
        }

        const estTimeEl = document.getElementById('est-time-remaining');
        if (estTimeEl) {
          const remainingCount = totalQuestions - index;
          const totalSeconds = remainingCount * 15;
          if (totalSeconds < 60) {
            estTimeEl.textContent = `Est. Time: ~${totalSeconds} secs`;
          } else {
            const mins = Math.max(1, Math.round(totalSeconds / 60));
            estTimeEl.textContent = `Est. Time: ~${mins} min${mins > 1 ? 's' : ''}`;
          }
        }

        // Show current question, hide others
        const questionElems = document.querySelectorAll('#quiz-container > div');
        questionElems.forEach((elem, idx) => {
          if (idx === index) {
            elem.classList.remove('hidden');
          } else {
            elem.classList.add('hidden');
          }
        });

        // Update counter
        document.getElementById('question-counter').textContent = `Question ${index + 1} of ${totalQuestions}`;

        // Reset timer
        clearInterval(timerInterval);
        timeLeft = TIME_LIMIT;
        updateTimerUI();

        // Update bottom action buttons
        updateBottomButtonState(false);

        // Start countdown
        timerInterval = setInterval(() => {
          if (isQuizPaused) return;
          timeLeft -= 0.1;
          if (timeLeft <= 0) {
            timeLeft = 0;
            clearInterval(timerInterval);
            lockQuestion(index, null);
          }
          updateTimerUI();
        }, 100);

        autosaveQuizState();

        if (window.speechEngine && window.speechEngine.isNarrationEnabled()) {
          const currentQuestion = questionsData[index];
          if (currentQuestion) {
            window.speechEngine.speak(currentQuestion.question);
          }
        }
      }

      let isQuizPaused = false;
      function togglePauseQuiz() {
        isQuizPaused = !isQuizPaused;
        const pauseModal = document.getElementById('pause-modal');
        if (pauseModal) {
          pauseModal.classList.toggle('hidden', !isQuizPaused);
        }
      }

      function autosaveQuizState() {
        try {
          const state = {
            index: currentQuestionIndex,
            streak: currentSessionStreak,
            answers: answersSubmitted,
            timestamp: Date.now()
          };
          sessionStorage.setItem('active_quiz_autosave', JSON.stringify(state));
        } catch(e) {}
      }

      function openPreSubmitModal() {
        const grid = document.getElementById('pre-submit-grid');
        if (!grid) return;
        grid.innerHTML = '';

        const bookmarkedIds = new Set((JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]')).map(q => q.id));

        questionsData.forEach((q, idx) => {
          const isAnswered = answersSubmitted[`question-${q.id}`] !== null && answersSubmitted[`question-${q.id}`] !== undefined;
          const isBookmarked = bookmarkedIds.has(q.id);

          const badge = document.createElement('button');
          badge.type = 'button';
          badge.className = `p-3 rounded-lg font-bold text-xs border transition flex flex-col items-center justify-center gap-1 cursor-pointer ${
            isBookmarked 
              ? 'bg-amber-500/20 border-amber-500/50 text-amber-300'
              : isAnswered 
              ? 'bg-emerald-500/20 border-emerald-500/50 text-emerald-300' 
              : 'bg-stone-900 border-stone-800 text-stone-500'
          }`;
          badge.innerHTML = `<span>Q${idx + 1}</span><span class="text-[9px]">${isBookmarked ? '⭐' : isAnswered ? '✅' : '⚪'}</span>`;
          badge.onclick = () => {
            closePreSubmitModal();
            startQuestion(idx);
          };
          grid.appendChild(badge);
        });

        document.getElementById('pre-submit-modal').classList.remove('hidden');
      }

      function closePreSubmitModal() {
        document.getElementById('pre-submit-modal').classList.add('hidden');
      }

      let isFinalSubmitConfirmed = false;
      function confirmFinalSubmission() {
        isFinalSubmitConfirmed = true;
        closePreSubmitModal();
        document.getElementById('quiz-form').requestSubmit();
      }

      function lockQuestion(questionIndex, selectedOptionValue) {
        clearInterval(timerInterval);

        const questionElem = document.querySelector(`#quiz-container > div[data-question-index="${questionIndex}"]`);
        if (!questionElem) return;

        // Disable all radio buttons for this question
        const inputs = questionElem.querySelectorAll('input[type="radio"]');
        inputs.forEach(input => input.disabled = true);

        // Highlight correct and selected options
        const questionData = questionsData[questionIndex];
        const correctOption = questionData.correct_option;

        // Update correct streak tracker
        const hudStreakContainer = document.getElementById('hud-streak-container');
        const hudStreakCount = document.getElementById('hud-streak-count');
        
        if (selectedOptionValue !== null && parseInt(selectedOptionValue, 10) === correctOption) {
          currentSessionStreak++;
        } else {
          currentSessionStreak = 0;
          const specialMode = window.localStorage.getItem('specialMode');
          if (specialMode === 'sudden-death') {
            setTimeout(() => {
              alert('💀 Sudden Death! You answered incorrectly. Quiz terminated.');
              confirmFinalSubmission();
            }, 300);
          }
        }

        if (hudStreakContainer && hudStreakCount) {
          hudStreakCount.textContent = currentSessionStreak;
          if (currentSessionStreak > 0) {
            hudStreakContainer.classList.remove('hidden');
            hudStreakContainer.classList.add('flex');
            hudStreakContainer.style.transform = 'scale(1.1)';
            setTimeout(() => {
              hudStreakContainer.style.transform = 'scale(1)';
            }, 150);
          } else {
            hudStreakContainer.classList.add('hidden');
            hudStreakContainer.classList.remove('flex');
          }
        }

        const optionCards = questionElem.querySelectorAll('.option-card');
        
        optionCards.forEach((card) => {
          const radio = card.querySelector('input[type="radio"]');
          if (!radio) return;
          const optVal = parseInt(radio.value, 10);
          const labelDiv = card.querySelector('.option-label');
          
          labelDiv.classList.remove('hover:border-stone-700', 'hover:text-stone-200');
          card.classList.remove('cursor-pointer');
          card.classList.add('cursor-not-allowed');

          if (optVal === correctOption) {
            labelDiv.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
            labelDiv.classList.add('bg-emerald-950/40', 'border-emerald-500/60', 'text-emerald-300', 'shadow-sm', 'shadow-emerald-500/10');
            
            const checkIcon = document.createElement('span');
            checkIcon.className = 'ml-2 text-emerald-400 font-bold';
            checkIcon.textContent = '✅';
            labelDiv.appendChild(checkIcon);
          } else if (selectedOptionValue !== null && parseInt(selectedOptionValue) === optVal) {
            labelDiv.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
            labelDiv.classList.add('bg-red-950/40', 'border-red-500/60', 'text-red-300', 'shadow-sm', 'shadow-red-500/10');
            
            const crossIcon = document.createElement('span');
            crossIcon.className = 'ml-2 text-red-400 font-bold';
            crossIcon.textContent = '❌';
            labelDiv.appendChild(crossIcon);
          }
        });

        // Show explanation if available
        if (questionData.explanation) {
          const explanationDiv = document.createElement('div');
          explanationDiv.className = 'mt-4 p-4 bg-amber-950/20 border-l-2 border-amber-500/50 rounded-lg text-sm text-amber-200 animate-fade-in';
          explanationDiv.innerHTML = `<strong>Explanation:</strong> ${questionData.explanation}`;
          questionElem.appendChild(explanationDiv);

          if (window.speechEngine && window.speechEngine.isNarrationEnabled()) {
            window.speechEngine.speak(`Explanation. ${questionData.explanation}`);
          }
        }

        updateBottomButtonState(true);
      }

      function updateBottomButtonState(isLocked) {
        const actionBtn = document.getElementById('action-btn');
        const helperText = document.getElementById('action-helper-text');
        
        if (!actionBtn || !helperText) return;

        if (!isLocked) {
          actionBtn.disabled = true;
          actionBtn.type = 'button';
          actionBtn.textContent = 'Select an option';
          actionBtn.className = 'w-full sm:w-auto bg-stone-800 text-stone-500 font-semibold px-8 py-3 rounded-lg border border-stone-750 cursor-not-allowed transition duration-300';
          helperText.textContent = `Question ${currentQuestionIndex + 1} of ${totalQuestions}`;
        } else {
          actionBtn.disabled = false;
          if (currentQuestionIndex < totalQuestions - 1) {
            actionBtn.type = 'button';
            actionBtn.textContent = 'Next Question ➡️';
            actionBtn.className = 'w-full sm:w-auto bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold px-8 py-3 rounded-lg shadow-lg active:scale-[0.98] transition duration-300 cursor-pointer';
            helperText.textContent = 'Question complete. Ready to proceed to next.';
          } else {
            actionBtn.type = 'submit';
            actionBtn.textContent = 'Submit Quiz 🎉';
            actionBtn.className = 'w-full sm:w-auto bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-semibold px-8 py-3 rounded-lg shadow-lg active:scale-[0.98] transition duration-300 cursor-pointer';
            helperText.textContent = 'All questions complete. Submit to view results.';
          }
        }
      }

      async function loadQuestions(sectionId, difficulty, isReview = false) {
        if (isReview) {
          const reviewIds = JSON.parse(window.localStorage.getItem('activeReviewQuestionIds') || '[]');
          const response = await fetch('/api/quiz/questions-by-ids', {
            method: 'POST',
            body: JSON.stringify({ ids: reviewIds }),
            headers: { 'Content-Type': 'application/json' }
          });
          questionsData = await response.json();
        } else if (sectionId === 'custom-mix') {
          const count = window.localStorage.getItem('questionCount') || '5';
          const cats = window.localStorage.getItem('customMixCategories') || '';
          const response = await fetch(`/api/quiz/questions/custom-mix?categories=${cats}&count=${count}`);
          questionsData = await response.json();
        } else {
          const count = window.localStorage.getItem('questionCount') || '5';
          const response = await fetch(`/api/quiz/questions/${sectionId}/${difficulty}?count=${count}`);
          questionsData = await response.json();
        }
        totalQuestions = questionsData.length;
        quizStartTime = Date.now();

        const loadingElem = document.getElementById('quiz-loading');
        const quizForm = document.getElementById('quiz-form');
        const quizContainer = document.getElementById('quiz-container');

        quizContainer.innerHTML = '';
        
        // Reset state
        for (const key in answersSubmitted) {
          delete answersSubmitted[key];
        }
        questionsData.forEach(question => {
          answersSubmitted[`question-${question.id}`] = null;
        });

        questionsData.forEach((question, index) => {
          const questionElem = document.createElement('div');
          questionElem.classList.add('p-6', 'border', 'border-stone-800', 'rounded-xl', 'bg-stone-900/30', 'space-y-4', 'hidden');
          questionElem.setAttribute('data-question-index', index);

          // Prepare options list with original value mapping
          const optionsList = [
            { text: question.option1, val: 1 },
            { text: question.option2, val: 2 },
            { text: question.option3, val: 3 },
            { text: question.option4, val: 4 }
          ];

          // Fisher-Yates Shuffle
          for (let i = optionsList.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [optionsList[i], optionsList[j]] = [optionsList[j], optionsList[i]];
          }

          questionElem.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="flex items-start gap-3">
              <span class="bg-amber-500/20 text-amber-300 font-bold text-xs rounded-full px-2.5 py-1 mt-0.5">${index + 1}</span>
              <p class="text-lg font-medium text-stone-100">${question.question}</p>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
              <button type="button" class="copy-question-btn text-sm text-stone-400 hover:text-amber-300 hover:scale-110 active:scale-95 transition focus:outline-none px-2 py-1 bg-stone-850/60 hover:bg-stone-800 rounded border border-stone-800" title="Copy Question" data-question-id="${question.id}">
                📋
              </button>
              <button type="button" class="bookmark-btn text-xl text-amber-400 hover:scale-110 active:scale-95 transition focus:outline-none" data-question-id="${question.id}">
                ☆
              </button>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4 ml-8">
            ${optionsList.map((opt, optIdx) => `
              <label class="option-card relative cursor-pointer block">
                <input type="radio" name="question-${question.id}" value="${opt.val}" class="sr-only">
                <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200 flex items-center">
                  <span class="inline-block bg-stone-800 text-stone-500 text-[10px] font-mono px-1.5 py-0.5 rounded mr-2.5 border border-stone-750 font-bold flex-shrink-0">${optIdx + 1}</span>
                  <span>${opt.text}</span>
                </div>
              </label>
            `).join('')}
          </div>
        `;
          quizContainer.appendChild(questionElem);

          questionElem.querySelector('.copy-question-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            copyQuestionToClipboard(question);
          });

          questionElem.querySelector('.bookmark-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            toggleBookmark(question.id);
          });
          updateBookmarkUI(question.id);
          
          questionElem
            .querySelectorAll('input[type="radio"]')
            .forEach(radio => {
              radio.addEventListener('change', (e) => {
                if (localStorage.getItem('soundEnabled') !== 'false') {
                  playClickSound();
                }
                triggerHapticFeedback();
                const val = e.target.value;
                const questionId = question.id;
                answersSubmitted[`question-${questionId}`] = val;
                lockQuestion(index, val);
              });
            });
        });

        loadingElem.classList.add('hidden');
        quizForm.classList.remove('hidden');

        if (totalQuestions > 0) {
          startQuestion(0);
        }
      }

      document.getElementById('action-btn').addEventListener('click', () => {
        const actionBtn = document.getElementById('action-btn');
        if (actionBtn.type === 'button' && !actionBtn.disabled) {
          startQuestion(currentQuestionIndex + 1);
        }
      });

      let remediationTriggered = false;

      document.getElementById('quiz-form').addEventListener('submit', async function (event) {
        event.preventDefault();

        if (!isFinalSubmitConfirmed && window.localStorage.getItem('multiplayer') !== 'true') {
          openPreSubmitModal();
          return;
        }
        
        // Intercept for Adaptive Remediation
        if (!remediationTriggered && window.localStorage.getItem('multiplayer') !== 'true' && window.localStorage.getItem('challengeMode') !== 'true') {
          const correctCount = Object.keys(answersSubmitted).filter(key => {
            const qId = parseInt(key.replace('question-', ''), 10);
            const q = questionsData.find(item => item.id === qId);
            return q && parseInt(answersSubmitted[key], 10) === q.correct_option;
          }).length;
          
          const accuracyRate = questionsData.length > 0 ? (correctCount / questionsData.length) : 1;
          
          if (accuracyRate < 0.5) {
            remediationTriggered = true;
            const submitBtn = document.getElementById('action-btn');
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<span class="animate-pulse">Loading Remediation...</span>`;
            
            const wrongQuestions = questionsData.filter(q => {
              const ans = answersSubmitted[`question-${q.id}`];
              return parseInt(ans, 10) !== q.correct_option;
            });
            
            try {
              const sectionId = window.localStorage.getItem('sectionId');
              const response = await fetch('/api/quiz/remediation', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ sectionId, wrongQuestions })
              });
              
              const remQ = await response.json();
              if (remQ && remQ.question) {
                remQ.id = 999999;
                questionsData.push(remQ);
                totalQuestions = questionsData.length;
                answersSubmitted[`question-${remQ.id}`] = null;
                
                const index = questionsData.length - 1;
                const questionElem = document.createElement('div');
                questionElem.classList.add('p-6', 'border', 'border-stone-800', 'rounded-xl', 'bg-stone-900/30', 'space-y-4', 'hidden');
                questionElem.setAttribute('data-question-index', index);
                
                const optionsList = [
                  { text: remQ.option1, val: 1 },
                  { text: remQ.option2, val: 2 },
                  { text: remQ.option3, val: 3 },
                  { text: remQ.option4, val: 4 }
                ];
                
                let optionsHtml = '';
                optionsList.forEach(opt => {
                  optionsHtml += `
                    <label class="option-card block cursor-pointer select-none">
                      <input type="radio" name="remediation-radio" value="${opt.val}" class="hidden">
                      <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 text-stone-400 hover:border-stone-700 hover:text-stone-200 rounded-lg text-sm transition flex items-center">
                        <span class="font-semibold mr-2">${String.fromCharCode(64 + opt.val)}.</span>
                        <span>${opt.text}</span>
                      </div>
                    </label>
                  `;
                });
                
                questionElem.innerHTML = `
                  <div class="p-3 bg-amber-500/10 border border-amber-500/20 rounded-xl mb-4 text-center">
                    <p class="text-xs font-bold text-amber-400">💡 ADAPTIVE REMEDIATION BONUS QUESTION</p>
                    <p class="text-[10px] text-stone-400 mt-0.5">Let's review the concepts you missed to boost your score!</p>
                  </div>
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3">
                      <span class="bg-amber-500 text-stone-950 font-bold text-xs rounded-full w-5 h-5 flex items-center justify-center flex-shrink-0 mt-0.5">R</span>
                      <p class="text-lg font-medium text-stone-100">${remQ.question}</p>
                    </div>
                  </div>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4 ml-8">
                    ${optionsHtml}
                  </div>
                `;
                
                document.getElementById('quiz-container').appendChild(questionElem);
                
                questionElem.querySelectorAll('input[type="radio"]').forEach(radio => {
                  radio.addEventListener('change', (e) => {
                    if (localStorage.getItem('soundEnabled') !== 'false') {
                      playClickSound();
                    }
                    triggerHapticFeedback();
                    const val = e.target.value;
                    answersSubmitted[`question-${remQ.id}`] = val;
                    
                    questionElem.querySelectorAll('.option-card').forEach(card => {
                      const r = card.querySelector('input[type="radio"]');
                      const labelDiv = card.querySelector('.option-label');
                      const optVal = parseInt(r.value, 10);
                      
                      labelDiv.classList.remove('hover:border-stone-700', 'hover:text-stone-200');
                      card.classList.remove('cursor-pointer');
                      card.classList.add('cursor-not-allowed');
                      r.disabled = true;
                      
                      if (optVal === remQ.correct_option) {
                        labelDiv.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
                        labelDiv.classList.add('bg-emerald-950/40', 'border-emerald-500/60', 'text-emerald-300');
                        const check = document.createElement('span');
                        check.textContent = '✅';
                        check.className = 'ml-2 text-emerald-400 font-bold';
                        labelDiv.appendChild(check);
                      } else if (parseInt(val) === optVal) {
                        labelDiv.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
                        labelDiv.classList.add('bg-red-950/40', 'border-red-500/60', 'text-red-300');
                        const cross = document.createElement('span');
                        cross.textContent = '❌';
                        cross.className = 'ml-2 text-red-400 font-bold';
                        labelDiv.appendChild(cross);
                      }
                    });
                    
                    const expDiv = document.createElement('div');
                    expDiv.className = 'mt-4 p-4 bg-amber-950/20 border-l-2 border-amber-500/50 rounded-lg text-sm text-amber-200 animate-fade-in';
                    expDiv.innerHTML = `<strong>Explanation:</strong> ${remQ.explanation}`;
                    questionElem.appendChild(expDiv);
                    
                    updateBottomButtonState(true);
                  });
                });
                
                currentQuestionIndex = index;
                startQuestion(index);
                return;
              }
            } catch (err) {
              console.error("Error fetching remediation question:", err);
            }
          }
        }

        const data = { ...answersSubmitted };

        // Show loader on submit button
        const submitBtn = document.getElementById('action-btn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="animate-pulse">Submitting...</span>`;

        try {
          const response = await fetch('/api/quiz/submit', {
            method: 'POST',
            body: JSON.stringify(data),
            headers: { 'Content-Type': 'application/json' }
          });

          const result = await response.json();
          if (result.incorrectIds && Array.isArray(result.incorrectIds)) {
            window.localStorage.setItem('lastIncorrectQuestionIds', JSON.stringify(result.incorrectIds));
          }
          const userName = window.localStorage.getItem('userName');
          const sectionId = window.localStorage.getItem('sectionId');

          // Check if challenge mode is active
          const isChallenge = window.localStorage.getItem('challengeMode') === 'true';
          const urlParams = new URLSearchParams(window.location.search);
          const isReview = urlParams.get('review') === 'true';

          if (isReview) {
            window.localStorage.setItem('userAnswers', JSON.stringify(data));
            window.location.href = `/result?score=${result.score}&total=${result.total}&review=true`;
          } else if (isChallenge && quizStartTime) {
            const elapsed = Date.now() - quizStartTime;
            
            // Save challenge score with time
            await fetch('/api/quiz/save-challenge', {
              method: 'POST',
              body: JSON.stringify({ userName, sectionId, result, timeMs: elapsed }),
              headers: { 'Content-Type': 'application/json' }
            });
            
            // Save answers and redirect with challenge flag
            window.localStorage.setItem('userAnswers', JSON.stringify(data));
            window.location.href = `/result?score=${result.score}&total=${result.total}&sectionId=${sectionId}&challenge=true&timeMs=${elapsed}`;
          } else {
            // Save standard score
            await fetch('/api/quiz/save-result', {
              method: 'POST',
              body: JSON.stringify({ userName, sectionId, result }),
              headers: { 'Content-Type': 'application/json' }
            });

            // Save user answers for explanations review
            window.localStorage.setItem('userAnswers', JSON.stringify(data));
            window.location.href = `/result?score=${result.score}&total=${result.total}&sectionId=${sectionId}`;
          }
        } catch (err) {
          console.error("Error submitting quiz:", err);
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Quiz 🎉";
          alert("An error occurred while submitting. Please try again.");
        }
      });

      function initThemeToggle() {
        const toggleBtn = document.createElement('button');
        toggleBtn.id = 'theme-toggle';
        toggleBtn.className = 'fixed top-4 right-4 bg-stone-900/80 hover:bg-stone-800 text-stone-200 p-3 rounded-full border border-stone-800 hover:border-stone-700 shadow-lg active:scale-95 transition z-50 text-xl w-12 h-12 flex items-center justify-center';
        toggleBtn.setAttribute('aria-label', 'Toggle theme');
        
        const isLight = document.documentElement.classList.contains('theme-light');
        toggleBtn.textContent = isLight ? '🌙' : '☀️';

        document.body.appendChild(toggleBtn);

        toggleBtn.addEventListener('click', () => {
          const currentlyLight = document.documentElement.classList.contains('theme-light');
          if (currentlyLight) {
            document.documentElement.classList.remove('theme-light');
            localStorage.setItem('theme', 'dark');
            toggleBtn.textContent = '☀️';
          } else {
            document.documentElement.classList.add('theme-light');
            localStorage.setItem('theme', 'light');
            toggleBtn.textContent = '🌙';
          }
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        initThemeToggle();

        const soundToggle = document.getElementById('sound-toggle');

        let soundEnabled =
          localStorage.getItem('soundEnabled') !== 'false';

        soundToggle.textContent =
          soundEnabled ? '🔊' : '🔇';

        soundToggle.addEventListener('click', () => {
          soundEnabled = !soundEnabled;

          localStorage.setItem(
            'soundEnabled',
            soundEnabled
          );

          soundToggle.textContent =
            soundEnabled ? '🔊' : '🔇';
        });

        // Speech & Voice Engine Setup
        const voiceBtn = document.getElementById('voice-command-toggle');
        const readAloudBtn = document.getElementById('btn-read-aloud');

        if (window.speechEngine) {
          if (!window.speechEngine.isSupported() && voiceBtn) {
            voiceBtn.title = "Speech Recognition not supported in this browser";
            voiceBtn.classList.add('opacity-40', 'cursor-not-allowed');
          } else if (voiceBtn) {
            voiceBtn.addEventListener('click', () => {
              window.speechEngine.toggleListening();
            });
          }

          if (readAloudBtn) {
            readAloudBtn.addEventListener('click', () => {
              window.speechEngine.toggleNarration();
            });
          }
        }
        const userName = window.localStorage.getItem('userName');
        const sectionId = window.localStorage.getItem('sectionId');
        const difficulty = window.localStorage.getItem('difficulty');

        const urlParams = new URLSearchParams(window.location.search);
        const isReview = urlParams.get('review') === 'true';

        if (isReview) {
          if (!userName) {
            window.location.href = '/';
            return;
          }
          document.getElementById('user-name-display').textContent = userName;
          document.getElementById('section-name-display').textContent = 'Spaced Repetition Review';
          loadQuestions(null, null, true);
          return;
        }

        if (!userName || !sectionId || !difficulty) {
          window.location.href = '/';
          return;
        }

        document.getElementById('user-name-display').textContent = userName;
        loadSectionName(sectionId);
        const isMultiplayer = window.localStorage.getItem('multiplayer') === 'true';
        if (isMultiplayer) {
          const socket = io();
          const roomMode = window.localStorage.getItem('roomMode') || 'competitive';
          
          if (roomMode === 'cooperative') {
            document.getElementById('cooperative-scoreboard').classList.remove('hidden');
          } else {
            document.getElementById('multiplayer-scoreboard').classList.remove('hidden');
          }
          
          socket.emit('quizReady', { roomCode: window.localStorage.getItem('roomCode') });

          socket.on('loadQuestion', ({ questionIndex, totalQuestions, question }) => {
            // Build the question card dynamically
            const quizContainer = document.getElementById('quiz-container');
            quizContainer.innerHTML = '';
            
            const questionElem = document.createElement('div');
            questionElem.className = 'p-6 border border-stone-800 rounded-xl bg-stone-900/30 space-y-4';
            questionElem.setAttribute('data-question-index', questionIndex);
            
            const optionsList = [
              { text: question.option1, val: 1 },
              { text: question.option2, val: 2 },
              { text: question.option3, val: 3 },
              { text: question.option4, val: 4 }
            ];
            
            for (let i = optionsList.length - 1; i > 0; i--) {
              const j = Math.floor(Math.random() * (i + 1));
              [optionsList[i], optionsList[j]] = [optionsList[j], optionsList[i]];
            }
            
            questionElem.innerHTML = `
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-3">
                  <span class="bg-amber-500/20 text-amber-300 font-bold text-xs rounded-full px-2.5 py-1 mt-0.5">${questionIndex + 1}</span>
                  <p class="text-lg font-medium text-stone-100">${question.question}</p>
                </div>
                <div class="flex items-center gap-2 flex-shrink-0">
                  <button type="button" class="copy-question-btn text-sm text-stone-400 hover:text-amber-300 hover:scale-110 active:scale-95 transition focus:outline-none px-2 py-1 bg-stone-850/60 hover:bg-stone-800 rounded border border-stone-800" title="Copy Question" data-question-id="${question.id}">
                    📋
                  </button>
                  <button type="button" class="bookmark-btn text-xl text-amber-400 hover:scale-110 active:scale-95 transition focus:outline-none" data-question-id="${question.id}">
                    ☆
                  </button>
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4 ml-8">
                ${optionsList.map((opt, optIdx) => `
                  <label class="option-card relative cursor-pointer block">
                    <input type="radio" name="question-${question.id}" value="${opt.val}" class="sr-only">
                    <div class="option-label p-3.5 border border-stone-800 bg-stone-950/45 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200 flex items-center">
                      <span class="inline-block bg-stone-850 text-stone-500 text-[10px] font-mono px-1.5 py-0.5 rounded mr-2.5 border border-stone-800 font-bold flex-shrink-0">${optIdx + 1}</span>
                      <span>${opt.text}</span>
                    </div>
                  </label>
                `).join('')}
              </div>
            `;
            quizContainer.appendChild(questionElem);
            
            questionElem.querySelector('.copy-question-btn').addEventListener('click', (e) => {
              e.stopPropagation();
              copyQuestionToClipboard(question);
            });

            // Star toggle
            questionElem.querySelector('.bookmark-btn').addEventListener('click', (e) => {
              e.stopPropagation();
              let bookmarks = JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]');
              const idx = bookmarks.findIndex(b => b.id === question.id);
              if (idx > -1) {
                bookmarks.splice(idx, 1);
              } else {
                bookmarks.push(question);
              }
              localStorage.setItem('bookmarkedQuestions', JSON.stringify(bookmarks));
              const isBookmarked = bookmarks.some(b => b.id === question.id);
              e.currentTarget.innerHTML = isBookmarked ? '★' : '☆';
            });

            // Star state initial sync
            const bookmarks = JSON.parse(localStorage.getItem('bookmarkedQuestions') || '[]');
            if (bookmarks.some(b => b.id === question.id)) {
              questionElem.querySelector('.bookmark-btn').innerHTML = '★';
            }

            // Radio events
            questionElem.querySelectorAll('input[type="radio"]').forEach(radio => {
              radio.addEventListener('change', (e) => {
                if (localStorage.getItem('soundEnabled') !== 'false') {
                  playClickSound();
                }
                triggerHapticFeedback();
                const val = e.target.value;
                socket.emit('submitAnswer', { roomCode: window.localStorage.getItem('roomCode'), answerVal: val });
                
                const label = radio.closest('.option-card').querySelector('.option-label');
                label.innerHTML += ` <span class="text-[10px] text-amber-500 italic ml-2">Locked</span>`;
                questionElem.querySelectorAll('input[type="radio"]').forEach(r => r.disabled = true);
              });
            });

            document.getElementById('question-counter').textContent = `Question ${questionIndex + 1} of ${totalQuestions}`;
            
            // Update visual progress bar indicator
            const progressPercent = totalQuestions > 0 ? ((questionIndex) / totalQuestions) * 100 : 0;
            const progressBar = document.getElementById('quiz-progress-bar');
            const progressText = document.getElementById('quiz-progress-text');
            if (progressBar) {
              progressBar.style.width = `${progressPercent}%`;
            }
            if (progressText) {
              progressText.textContent = `${questionIndex} / ${totalQuestions} Completed`;
            }

            document.getElementById('quiz-loading').classList.add('hidden');
            document.getElementById('quiz-form').classList.remove('hidden');
            document.getElementById('quiz-actions').classList.add('hidden');

            clearInterval(timerInterval);
            timeLeft = TIME_LIMIT;
            updateTimerUI();
            timerInterval = setInterval(() => {
              timeLeft -= 0.1;
              if (timeLeft <= 0) {
                timeLeft = 0;
                clearInterval(timerInterval);
              }
              updateTimerUI();
            }, 100);

            document.getElementById('multiplayer-announcement').classList.add('hidden');
          });

          socket.on('revealAnswer', ({ correctOption, explanation, mode, groupAccuracy, playerAnswers }) => {
            clearInterval(timerInterval);
            const questionElem = document.querySelector(`#quiz-container > div`);
            if (!questionElem) return;

            const optionCards = questionElem.querySelectorAll('.option-card');
            const radioChecked = questionElem.querySelector('input[type="radio"]:checked');
            const selectedOptionValue = radioChecked ? parseInt(radioChecked.value, 10) : null;

            if (mode === 'cooperative') {
              const accuracyVal = document.getElementById('coop-accuracy-val');
              if (accuracyVal) accuracyVal.textContent = groupAccuracy + '%';
              
              const banner = document.getElementById('multiplayer-announcement');
              if (banner && playerAnswers) {
                const summaryText = playerAnswers.map(pa => `${pa.name}: ${pa.correct ? '✅' : '❌'}`).join(' | ');
                banner.textContent = `📋 Round: ${summaryText}`;
                banner.classList.remove('hidden');
              }
            }

            // Update correct streak tracker
            const hudStreakContainer = document.getElementById('hud-streak-container');
            const hudStreakCount = document.getElementById('hud-streak-count');
            
            if (selectedOptionValue !== null && selectedOptionValue === correctOption) {
              currentSessionStreak++;
            } else {
              currentSessionStreak = 0;
            }

            if (hudStreakContainer && hudStreakCount) {
              hudStreakCount.textContent = currentSessionStreak;
              if (currentSessionStreak > 0) {
                hudStreakContainer.classList.remove('hidden');
                hudStreakContainer.classList.add('flex');
                hudStreakContainer.style.transform = 'scale(1.1)';
                setTimeout(() => {
                  hudStreakContainer.style.transform = 'scale(1)';
                }, 150);
              } else {
                hudStreakContainer.classList.add('hidden');
                hudStreakContainer.classList.remove('flex');
              }
            }
            
            optionCards.forEach((card) => {
              const radio = card.querySelector('input[type="radio"]');
              if (!radio) return;
              radio.disabled = true;
              const optVal = parseInt(radio.value, 10);
              const labelDiv = card.querySelector('.option-label');
              labelDiv.classList.remove('hover:border-stone-700', 'hover:text-stone-200');
              
              if (optVal === correctOption) {
                labelDiv.className = 'option-label p-3.5 border bg-emerald-950/40 border-emerald-500/60 text-emerald-300 shadow-sm shadow-emerald-500/10 rounded-lg text-sm flex items-center';
                const checkIcon = document.createElement('span');
                checkIcon.className = 'ml-2 text-emerald-400 font-bold';
                checkIcon.textContent = '✅';
                labelDiv.appendChild(checkIcon);
              } else if (selectedOptionValue !== null && selectedOptionValue === optVal) {
                labelDiv.className = 'option-label p-3.5 border bg-red-950/40 border-red-500/60 text-red-300 shadow-sm shadow-red-500/10 rounded-lg text-sm flex items-center';
                const crossIcon = document.createElement('span');
                crossIcon.className = 'ml-2 text-red-400 font-bold';
                crossIcon.textContent = '❌';
                labelDiv.appendChild(crossIcon);
              }
            });

            if (explanation) {
              const explanationDiv = document.createElement('div');
              explanationDiv.className = 'mt-4 p-4 bg-amber-950/20 border-l-2 border-amber-500/50 rounded-lg text-sm text-amber-200 animate-fade-in';
              explanationDiv.innerHTML = `<strong>Explanation:</strong> ${explanation}`;
              questionElem.appendChild(explanationDiv);
            }
          });

          socket.on('scoreboardUpdate', ({ players }) => {
            const roomMode = window.localStorage.getItem('roomMode') || 'competitive';
            if (roomMode === 'cooperative') {
              const coopList = document.getElementById('coop-players-list');
              if (coopList) {
                coopList.innerHTML = '';
                players.forEach(p => {
                  const div = document.createElement('div');
                  div.className = "flex flex-col items-center bg-stone-900 border border-stone-850 p-2 rounded-lg";
                  div.innerHTML = `
                    <span class="text-xs font-bold text-stone-300 truncate w-full">${p.name}</span>
                    <span class="text-sm font-extrabold text-emerald-400 mt-1">${p.score} pts</span>
                  `;
                  coopList.appendChild(div);
                });
              }
            } else {
              if (players.length >= 2) {
                document.getElementById('p1-name').textContent = players[0].name;
                document.getElementById('p1-score').textContent = players[0].score;
                document.getElementById('p2-name').textContent = players[1].name;
                document.getElementById('p2-score').textContent = players[1].score;
              }
            }
          });

          socket.on('firstCorrect', ({ winnerName }) => {
            const banner = document.getElementById('multiplayer-announcement');
            banner.textContent = `🎯 ${winnerName} got it correct first! (+1 point)`;
            banner.classList.remove('hidden');
          });

          socket.on('playerSubmitted', ({ name }) => {
            const banner = document.getElementById('multiplayer-announcement');
            banner.textContent = `⏳ ${name} locked in their answer. Waiting for you...`;
            banner.classList.remove('hidden');
          });

          socket.on('quizEnded', ({ mode, groupAccuracy, players }) => {
            const myName = window.localStorage.getItem('userName');
            const me = players.find(p => p.name === myName);
            const score = me ? me.score : 0;
            const total = totalQuestions || 5;
            
            const roomMode = window.localStorage.getItem('roomMode') || 'competitive';
            window.localStorage.removeItem('multiplayer');
            
            if (roomMode === 'cooperative') {
              window.location.href = `/result?score=${score}&total=${total}&sectionId=${window.localStorage.getItem('sectionId')}&coop=true&groupAccuracy=${groupAccuracy || 100}`;
            } else {
              const opponent = players.find(p => p.name !== myName);
              const opponentDetails = opponent ? `&opponentName=${opponent.name}&opponentScore=${opponent.score}` : '';
              window.location.href = `/result?score=${score}&total=${total}&sectionId=${window.localStorage.getItem('sectionId')}${opponentDetails}`;
            }
          });

          socket.on('playerDisconnected', (msg) => {
            alert(msg);
            window.location.href = '/';
          });

        } else {
          loadQuestions(sectionId, difficulty);
        }

        // Keyboard Navigation Support
        document.addEventListener('keydown', (e) => {
          if (document.activeElement.tagName === 'INPUT' || document.activeElement.tagName === 'TEXTAREA') {
            return;
          }

          const key = e.key;

          if (key === 'Escape') {
            const pauseModal = document.getElementById('pause-modal');
            if (pauseModal && !pauseModal.classList.contains('hidden')) {
              togglePauseQuiz();
            }
            const preSubmitModal = document.getElementById('pre-submit-modal');
            if (preSubmitModal && !preSubmitModal.classList.contains('hidden')) {
              closePreSubmitModal();
            }
          }

          if (['1', '2', '3', '4'].includes(key)) {
            const optionIndex = parseInt(key, 10) - 1;
            const currentQuestionElem = document.querySelector(`#quiz-container > div[data-question-index="${currentQuestionIndex}"]`);
            if (currentQuestionElem) {
              const cards = currentQuestionElem.querySelectorAll('.option-card');
              if (cards && cards[optionIndex]) {
                const radio = cards[optionIndex].querySelector('input[type="radio"]');
                if (radio && !radio.disabled) {
                  radio.checked = true;
                  radio.dispatchEvent(new Event('change'));
                }
              }
            }
          }

          if (key === 'Enter' || key === ' ') {
            e.preventDefault();
            const actionBtn = document.getElementById('action-btn');
            if (actionBtn && !actionBtn.disabled) {
              actionBtn.click();
            }
          }
        });
      });
    </script>
</body>

</html>
