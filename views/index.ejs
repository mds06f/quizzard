<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quiz Session - Quizzard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap"
    rel="stylesheet">
  <style>
    body {
      font-family: 'Outfit', sans-serif;
    }

    .glass-card {
      background: rgba(28, 25, 23, 0.75);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    /* Style for checked options */
    .option-card input[type="radio"]:checked+.option-label {
      background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(217, 119, 6, 0.15) 100%);
      border-color: rgba(217, 119, 6, 0.6);
      box-shadow: 0 0 10px rgba(245, 158, 11, 0.15);
      color: #fef3c7;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
      animation: fadeIn 0.3s ease-out forwards;
    }
  </style>
</head>

<body
  class="bg-gradient-to-br from-[#0a0a0a] via-[#171513] to-[#0d0c0a] text-stone-100 min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">
  <!-- Decorative background glow blobs -->
  <div class="absolute -top-40 -left-40 w-96 h-96 bg-amber-600/10 rounded-full blur-3xl -z-10"></div>
  <div class="absolute -bottom-40 -right-40 w-96 h-96 bg-orange-600/10 rounded-full blur-3xl -z-10"></div>

  <div class="max-w-3xl w-full">
    <!-- Header info -->
    <div class="flex flex-col sm:flex-row justify-between items-center mb-6 gap-4 px-2">
      <div class="flex items-center gap-3">
        <span class="text-3xl">📖</span>
        <div>
          <h2 class="text-xl font-bold ...">Quizzard Session</h2>
          <p class="text-xs text-stone-400">
            Welcome back,
            <span id="user-name-display" class="text-amber-300 font-semibold"></span>
          </p>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="bg-stone-900/60 border border-stone-850 rounded-lg px-4 py-2 text-right">
          <p class="text-xs text-stone-500 uppercase tracking-wider">Active Topic</p>
          <p id="section-name-display" class="text-sm font-semibold text-amber-300"></p>
        </div>

        <button id="sound-toggle" type="button"
          class="bg-stone-900/60 border border-stone-850 rounded-lg px-3 py-2 hover:border-amber-500/40 transition">
          🔊
        </button>
      </div>
    </div>

    <!-- Main quiz card -->
    <div class="glass-card rounded-2xl shadow-2xl p-6 sm:p-8">

      <!-- Loading state -->
      <div id="quiz-loading" class="flex flex-col items-center justify-center py-20 space-y-4">
        <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-amber-400"></div>
        <p class="text-stone-400 text-sm">Loading quiz questions...</p>
      </div>

      <!-- Quiz form -->
      <form id="quiz-form" class="hidden space-y-6">
        <!-- Timer Progress Bar -->
        <div id="timer-bar-container" class="space-y-2 mb-6">
          <div class="flex justify-between items-center text-xs text-stone-400">
            <span id="question-counter" class="font-medium text-stone-300">Question 1 of 5</span>
            <span id="timer-text" class="font-bold text-amber-400 flex items-center gap-1">
              ⏱️ <span id="timer-seconds">20</span>s
            </span>
          </div>
          <div class="h-1.5 w-full bg-stone-900 rounded-full overflow-hidden border border-stone-800">
            <div id="timer-progress" class="h-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-100" style="width: 100%;"></div>
          </div>
        </div>

        <div id="quiz-container" class="space-y-8"></div>

        <div id="quiz-actions" class="pt-4 border-t border-stone-850 flex flex-col sm:flex-row gap-4 justify-between items-center">
          <p id="action-helper-text" class="text-xs text-stone-500">Select an option to proceed.</p>
          <button id="action-btn" type="button" disabled
            class="w-full sm:w-auto bg-stone-800 text-stone-500 font-semibold px-8 py-3 rounded-lg border border-stone-750 cursor-not-allowed transition duration-300">
            Select an option
          </button>
        </div>
      </form>
    </div>

    <script>
      let audioCtx;

      function playClickSound() {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }

        if (audioCtx.state === "suspended") {
          audioCtx.resume();
        }

        const oscillator = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();

        oscillator.connect(gainNode);
        gainNode.connect(audioCtx.destination);

        oscillator.type = 'sine';
        oscillator.frequency.value = 700;

        gainNode.gain.value = 0.05;

        oscillator.start();
        oscillator.stop(audioCtx.currentTime + 0.08);
      }
      const TIME_LIMIT = 20;
      let timerInterval = null;
      let timeLeft = TIME_LIMIT;
      let currentQuestionIndex = 0;
      let totalQuestions = 0;
      let questionsData = [];
      const answersSubmitted = {};

      async function loadSectionName(sectionId) {
        const response = await fetch(`/api/quiz/sections/${sectionId}`);
        const section = await response.json();
        document.getElementById('section-name-display').textContent = section.name;
      }

      function updateTimerUI() {
        const progressPercent = (timeLeft / TIME_LIMIT) * 100;
        const progressEl = document.getElementById('timer-progress');
        const secondsEl = document.getElementById('timer-seconds');
        
        if (progressEl) {
          progressEl.style.width = `${progressPercent}%`;
          if (timeLeft < 5) {
            progressEl.className = 'h-full bg-red-500 transition-all duration-100';
          } else {
            progressEl.className = 'h-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all duration-100';
          }
        }
        if (secondsEl) {
          secondsEl.textContent = Math.ceil(timeLeft);
        }
      }

      function startQuestion(index) {
        currentQuestionIndex = index;
        
        // Show current question, hide others
        const questionElems = document.querySelectorAll('#quiz-container > div');
        questionElems.forEach((elem, idx) => {
          if (idx === index) {
            elem.classList.remove('hidden');
          } else {
            elem.classList.add('hidden');
          }
        });

        // Update counter
        document.getElementById('question-counter').textContent = `Question ${index + 1} of ${totalQuestions}`;

        // Reset timer
        clearInterval(timerInterval);
        timeLeft = TIME_LIMIT;
        updateTimerUI();

        // Update bottom action buttons
        updateBottomButtonState(false);

        // Start countdown
        timerInterval = setInterval(() => {
          timeLeft -= 0.1;
          if (timeLeft <= 0) {
            timeLeft = 0;
            clearInterval(timerInterval);
            lockQuestion(index, null);
          }
          updateTimerUI();
        }, 100);
      }

      function lockQuestion(questionIndex, selectedOptionValue) {
        clearInterval(timerInterval);

        const questionElem = document.querySelector(`#quiz-container > div[data-question-index="${questionIndex}"]`);
        if (!questionElem) return;

        // Disable all radio buttons for this question
        const inputs = questionElem.querySelectorAll('input[type="radio"]');
        inputs.forEach(input => input.disabled = true);

        // Highlight correct and selected options
        const questionData = questionsData[questionIndex];
        const correctOption = questionData.correct_option;
        const optionCards = questionElem.querySelectorAll('.option-card');
        
        optionCards.forEach((card, idx) => {
          const optVal = idx + 1;
          const labelDiv = card.querySelector('.option-label');
          
          labelDiv.classList.remove('hover:border-stone-700', 'hover:text-stone-200');
          card.classList.remove('cursor-pointer');
          card.classList.add('cursor-not-allowed');

          if (optVal === correctOption) {
            labelDiv.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
            labelDiv.classList.add('bg-emerald-950/40', 'border-emerald-500/60', 'text-emerald-300', 'shadow-sm', 'shadow-emerald-500/10');
            
            const checkIcon = document.createElement('span');
            checkIcon.className = 'ml-2 text-emerald-400 font-bold';
            checkIcon.textContent = '✅';
            labelDiv.appendChild(checkIcon);
          } else if (selectedOptionValue !== null && parseInt(selectedOptionValue) === optVal) {
            labelDiv.classList.remove('border-stone-800', 'bg-stone-950/40', 'text-stone-400');
            labelDiv.classList.add('bg-red-950/40', 'border-red-500/60', 'text-red-300', 'shadow-sm', 'shadow-red-500/10');
            
            const crossIcon = document.createElement('span');
            crossIcon.className = 'ml-2 text-red-400 font-bold';
            crossIcon.textContent = '❌';
            labelDiv.appendChild(crossIcon);
          }
        });

        // Show explanation if available
        if (questionData.explanation) {
          const explanationDiv = document.createElement('div');
          explanationDiv.className = 'mt-4 p-4 bg-amber-950/20 border-l-2 border-amber-500/50 rounded-lg text-sm text-amber-200 animate-fade-in';
          explanationDiv.innerHTML = `<strong>Explanation:</strong> ${questionData.explanation}`;
          questionElem.appendChild(explanationDiv);
        }

        updateBottomButtonState(true);
      }

      function updateBottomButtonState(isLocked) {
        const actionBtn = document.getElementById('action-btn');
        const helperText = document.getElementById('action-helper-text');
        
        if (!actionBtn || !helperText) return;

        if (!isLocked) {
          actionBtn.disabled = true;
          actionBtn.type = 'button';
          actionBtn.textContent = 'Select an option';
          actionBtn.className = 'w-full sm:w-auto bg-stone-800 text-stone-500 font-semibold px-8 py-3 rounded-lg border border-stone-750 cursor-not-allowed transition duration-300';
          helperText.textContent = `Question ${currentQuestionIndex + 1} of ${totalQuestions}`;
        } else {
          actionBtn.disabled = false;
          if (currentQuestionIndex < totalQuestions - 1) {
            actionBtn.type = 'button';
            actionBtn.textContent = 'Next Question ➡️';
            actionBtn.className = 'w-full sm:w-auto bg-gradient-to-r from-amber-600 to-orange-600 hover:from-amber-500 hover:to-orange-500 text-white font-semibold px-8 py-3 rounded-lg shadow-lg active:scale-[0.98] transition duration-300 cursor-pointer';
            helperText.textContent = 'Question complete. Ready to proceed to next.';
          } else {
            actionBtn.type = 'submit';
            actionBtn.textContent = 'Submit Quiz 🎉';
            actionBtn.className = 'w-full sm:w-auto bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-semibold px-8 py-3 rounded-lg shadow-lg active:scale-[0.98] transition duration-300 cursor-pointer';
            helperText.textContent = 'All questions complete. Submit to view results.';
          }
        }
      }

      async function loadQuestions(sectionId, difficulty) {
        const response = await fetch(`/api/quiz/questions/${sectionId}/${difficulty}`);
        questionsData = await response.json();
        totalQuestions = questionsData.length;

        const loadingElem = document.getElementById('quiz-loading');
        const quizForm = document.getElementById('quiz-form');
        const quizContainer = document.getElementById('quiz-container');

        quizContainer.innerHTML = '';
        
        // Reset state
        for (const key in answersSubmitted) {
          delete answersSubmitted[key];
        }
        questionsData.forEach(question => {
          answersSubmitted[`question-${question.id}`] = null;
        });

        questionsData.forEach((question, index) => {
          const questionElem = document.createElement('div');
          questionElem.classList.add('p-6', 'border', 'border-stone-800', 'rounded-xl', 'bg-stone-900/30', 'space-y-4', 'hidden');
          questionElem.setAttribute('data-question-index', index);

          questionElem.innerHTML = `
          <div class="flex items-start gap-3">
            <span class="bg-amber-500/20 text-amber-300 font-bold text-xs rounded-full px-2.5 py-1 mt-0.5">${index + 1}</span>
            <p class="text-lg font-medium text-stone-100">${question.question}</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mt-4 ml-8">
            <!-- Option 1 -->
            <label class="option-card relative cursor-pointer block">
              <input type="radio" name="question-${question.id}" value="1" class="sr-only">
              <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200">
                ${question.option1}
              </div>
            </label>

            <!-- Option 2 -->
            <label class="option-card relative cursor-pointer block">
              <input type="radio" name="question-${question.id}" value="2" class="sr-only">
              <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200">
                ${question.option2}
              </div>
            </label>

            <!-- Option 3 -->
            <label class="option-card relative cursor-pointer block">
              <input type="radio" name="question-${question.id}" value="3" class="sr-only">
              <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200">
                ${question.option3}
              </div>
            </label>

            <!-- Option 4 -->
            <label class="option-card relative cursor-pointer block">
              <input type="radio" name="question-${question.id}" value="4" class="sr-only">
              <div class="option-label p-3.5 border border-stone-800 bg-stone-950/40 hover:border-stone-700 rounded-lg text-sm text-stone-400 hover:text-stone-200 transition duration-200">
                ${question.option4}
              </div>
            </label>
          </div>
        `;
          quizContainer.appendChild(questionElem);
          
          questionElem
            .querySelectorAll('input[type="radio"]')
            .forEach(radio => {
              radio.addEventListener('change', (e) => {
                if (localStorage.getItem('soundEnabled') !== 'false') {
                  playClickSound();
                }
                const val = e.target.value;
                const questionId = question.id;
                answersSubmitted[`question-${questionId}`] = val;
                lockQuestion(index, val);
              });
            });
        });

        loadingElem.classList.add('hidden');
        quizForm.classList.remove('hidden');

        if (totalQuestions > 0) {
          startQuestion(0);
        }
      }

      document.getElementById('action-btn').addEventListener('click', () => {
        const actionBtn = document.getElementById('action-btn');
        if (actionBtn.type === 'button' && !actionBtn.disabled) {
          startQuestion(currentQuestionIndex + 1);
        }
      });

      document.getElementById('quiz-form').addEventListener('submit', async function (event) {
        event.preventDefault();
        
        const data = { ...answersSubmitted };

        // Show loader on submit button
        const submitBtn = document.getElementById('action-btn');
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span class="animate-pulse">Submitting...</span>`;

        try {
          const response = await fetch('/api/quiz/submit', {
            method: 'POST',
            body: JSON.stringify(data),
            headers: { 'Content-Type': 'application/json' }
          });

          const result = await response.json();
          const userName = window.localStorage.getItem('userName');
          const sectionId = window.localStorage.getItem('sectionId');

          await fetch('/api/quiz/save-result', {
            method: 'POST',
            body: JSON.stringify({ userName, sectionId, result }),
            headers: { 'Content-Type': 'application/json' }
          });

          // Save user answers for explanations review
          window.localStorage.setItem('userAnswers', JSON.stringify(data));

          window.location.href = `/result?score=${result.score}&total=${result.total}&sectionId=${sectionId}`;
        } catch (err) {
          console.error("Error submitting quiz:", err);
          submitBtn.disabled = false;
          submitBtn.textContent = "Submit Quiz 🎉";
          alert("An error occurred while submitting. Please try again.");
        }
      });

      document.addEventListener('DOMContentLoaded', () => {
        const soundToggle = document.getElementById('sound-toggle');

        let soundEnabled =
          localStorage.getItem('soundEnabled') !== 'false';

        soundToggle.textContent =
          soundEnabled ? '🔊' : '🔇';

        soundToggle.addEventListener('click', () => {
          soundEnabled = !soundEnabled;

          localStorage.setItem(
            'soundEnabled',
            soundEnabled
          );

          soundToggle.textContent =
            soundEnabled ? '🔊' : '🔇';
        });
        const userName = window.localStorage.getItem('userName');
        const sectionId = window.localStorage.getItem('sectionId');
        const difficulty = window.localStorage.getItem('difficulty');

        if (!userName || !sectionId || !difficulty) {
          window.location.href = '/';
          return;
        }

        document.getElementById('user-name-display').textContent = userName;
        loadSectionName(sectionId);
        loadQuestions(sectionId, difficulty);
      });
    </script>
</body>

</html>
